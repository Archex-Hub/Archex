---
// contact.astro — Parent Brand Dedicated Contact Page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Archex — Start a conversation"
  description="Tell us what you are working on. We will help direct your enquiry to the appropriate Archex practice: Craft, Studio, or GTM."
  canonical="https://www.archexweb.in/contact/"
  activePath="https://craft.archexweb.in/contact"
>
  <div class="shell contact-container">
    <!-- Meta Header -->
    <div class="contact-header">
      <span class="tech-tag tech-tag--signal">Enquiry Gateway</span>
      <h1 class="contact-title">
        Let's start a conversation<span class="hl-dot">.</span>
      </h1>
      <p class="contact-subtitle">
        Tell us a little about what you have in mind. We'll direct your enquiry to the appropriate Archex practice.
      </p>
    </div>

    <div class="contact-layout">
      <!-- Main Form Column -->
      <div class="contact-form-column">
        <!-- Success State Container -->
        <div id="submission-success" class="submission-card submission-card--success" hidden role="region" aria-live="polite">
          <div class="success-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="success-content">
            <h2 class="success-heading">Enquiry received</h2>
            <p class="success-message">
              Thank you for reaching out. Your enquiry has been routed to the relevant Archex practice. We will review your project details and respond via email within 1–2 business days.
            </p>
            <div class="success-meta">
              <span class="meta-label">Reference ID:</span>
              <span class="meta-value" id="success-ref">AX-000000</span>
              <span class="meta-separator">•</span>
              <span class="meta-label">Routing:</span>
              <span class="meta-value" id="success-practice">Archex Ecosystem</span>
            </div>
            <button type="button" id="btn-submit-another" class="btn-base btn-secondary success-another-btn">
              Send another enquiry
            </button>
          </div>
        </div>

        <!-- Failure State Container -->
        <div id="submission-error" class="form-status-banner form-status-banner--error" hidden role="alert">
          <strong id="error-title">Submission could not be completed</strong>
          <span id="error-message">A network issue occurred while dispatching your enquiry. Please check your connection and try again.</span>
        </div>

        <!-- The Contact Form -->
        <form id="archex-contact-form" class="contact-form" novalidate aria-label="Archex enquiry form">
          <!-- Honeypot anti-spam field -->
          <div class="hp-field" aria-hidden="true">
            <label for="_archex_hp">Leave this field blank</label>
            <input type="text" id="_archex_hp" name="_archex_hp" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-grid">
            <!-- 1. Full Name (Required) -->
            <div class="form-group">
              <label for="fullName" class="form-label">
                <span>Full name <span class="form-label-required">*</span></span>
              </label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                class="form-input"
                placeholder="e.g. Kaif Sayed"
                required
                aria-required="true"
                autocomplete="name"
                aria-describedby="fullName-error"
              />
              <span class="form-error" id="fullName-error" aria-live="polite"></span>
            </div>

            <!-- 2. Work Email (Required) -->
            <div class="form-group">
              <label for="workEmail" class="form-label">
                <span>Work email <span class="form-label-required">*</span></span>
              </label>
              <input
                type="email"
                id="workEmail"
                name="workEmail"
                class="form-input"
                placeholder="name@company.com"
                required
                aria-required="true"
                autocomplete="email"
                aria-describedby="workEmail-error"
              />
              <span class="form-error" id="workEmail-error" aria-live="polite"></span>
            </div>

            <!-- 3. Company or Organisation (Optional) -->
            <div class="form-group">
              <label for="company" class="form-label">
                <span>Company or organisation</span>
                <span class="form-label-optional">Optional</span>
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="form-input"
                placeholder="Organisation name"
                autocomplete="organization"
              />
            </div>

            <!-- 4. Practice of Interest (Required) -->
            <div class="form-group">
              <label for="practice" class="form-label">
                <span>Practice of interest <span class="form-label-required">*</span></span>
              </label>
              <select
                id="practice"
                name="practice"
                class="form-select"
                required
                aria-required="true"
                aria-describedby="practice-error"
              >
                <option value="">Select a practice...</option>
                <option value="craft">Archex Craft (Software Engineering & Digital Products)</option>
                <option value="studio">Archex Studio (Brand Identity & UI/UX Design)</option>
                <option value="gtm">Archex GTM (Go-to-market Strategy & Growth)</option>
                <option value="multiple">Multiple practices (Collaborative engagement)</option>
                <option value="not-sure">Not sure yet (Help direct enquiry)</option>
              </select>
              <span class="form-error" id="practice-error" aria-live="polite"></span>
            </div>

            <!-- 5. Nature of Enquiry (Required, Full width) -->
            <div class="form-group form-grid--full">
              <label for="enquiry" class="form-label">
                <span>Nature of enquiry <span class="form-label-required">*</span></span>
              </label>
              <textarea
                id="enquiry"
                name="enquiry"
                class="form-textarea"
                rows="4"
                placeholder="Describe what you are working on, your key objectives, and any known challenges..."
                required
                aria-required="true"
                aria-describedby="enquiry-error"
              ></textarea>
              <span class="form-error" id="enquiry-error" aria-live="polite"></span>
            </div>

            <!-- 6. Approximate Budget (Optional) -->
            <div class="form-group">
              <label for="budget" class="form-label">
                <span>Approximate budget</span>
                <span class="form-label-optional">Optional</span>
              </label>
              <select id="budget" name="budget" class="form-select">
                <option value="">Select approximate range...</option>
                <option value="under-10k">Under $10,000 / ₹8 Lakhs</option>
                <option value="10k-25k">$10,000 – $25,000 / ₹8 – ₹20 Lakhs</option>
                <option value="25k-50k">$25,000 – $50,000 / ₹20 – ₹40 Lakhs</option>
                <option value="50k-plus">$50,000+ / ₹40 Lakhs+</option>
                <option value="flexible">Flexible / To be determined</option>
              </select>
            </div>

            <!-- 7. Expected Timeline (Optional) -->
            <div class="form-group">
              <label for="timeline" class="form-label">
                <span>Expected timeline</span>
                <span class="form-label-optional">Optional</span>
              </label>
              <select id="timeline" name="timeline" class="form-select">
                <option value="">Select expected timeline...</option>
                <option value="immediate">Immediate (within 1 month)</option>
                <option value="1-3-months">1 to 3 months</option>
                <option value="3-6-months">3 to 6 months</option>
                <option value="exploratory">Exploratory / Planning stage</option>
              </select>
            </div>

            <!-- 8. Additional Information (Optional, Full width) -->
            <div class="form-group form-grid--full">
              <label for="additionalInfo" class="form-label">
                <span>Additional information</span>
                <span class="form-label-optional">Optional</span>
              </label>
              <textarea
                id="additionalInfo"
                name="additionalInfo"
                class="form-textarea"
                rows="3"
                placeholder="Any links, technical requirements, existing documentation, or other helpful context..."
              ></textarea>
            </div>

            <!-- Mandatory Purpose-Specific Privacy Consent -->
            <div class="form-group form-grid--full">
              <label class="form-checkbox-group" for="privacyConsent">
                <input
                  type="checkbox"
                  id="privacyConsent"
                  name="privacyConsent"
                  class="form-checkbox"
                  required
                  aria-required="true"
                  aria-describedby="privacyConsent-error"
                />
                <span class="form-checkbox-text">
                  I agree that Archex may process the personal information submitted above solely for the purpose of reviewing and responding to this enquiry, in accordance with the <a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>. <span class="form-label-required">*</span>
                </span>
              </label>
              <span class="form-error" id="privacyConsent-error" aria-live="polite"></span>
            </div>

            <!-- Explicitly Separate Optional Marketing Consent -->
            <div class="form-group form-grid--full">
              <label class="form-checkbox-group" for="marketingConsent">
                <input
                  type="checkbox"
                  id="marketingConsent"
                  name="marketingConsent"
                  class="form-checkbox"
                />
                <span class="form-checkbox-text">
                  Optional: Receive occasional publications, engineering insights, and ecosystem updates from Archex. (Unsubscribable at any time; never required for enquiry processing).
                </span>
              </label>
            </div>
          </div>

          <!-- Form Submit Actions -->
          <div class="form-actions">
            <button type="submit" id="submit-btn" class="btn-base btn-primary contact-submit-btn">
              <span id="btn-text">Send enquiry</span>
              <span id="btn-spinner" class="submit-spinner" hidden aria-hidden="true"></span>
              <span class="btn-arrow" id="btn-arrow" aria-hidden="true">→</span>
            </button>
            <span class="form-reassurance">
              Enquiries are reviewed directly by practice leads. No marketing spam.
            </span>
          </div>
        </form>
      </div>

      <!-- Practice Direct Routing Sidebar -->
      <aside class="contact-sidebar" aria-label="Practice contact overview">
        <div class="sidebar-block">
          <span class="sidebar-label">Direct Practice Routing</span>
          <p class="sidebar-note">
            Your enquiry will be routed based on the practice of interest you specify:
          </p>

          <div class="practice-route-list">
            <div class="practice-route-card">
              <div class="route-header">
                <span class="route-badge">01 // CRAFT</span>
                <span class="route-domain">craft.archexweb.in</span>
              </div>
              <p class="route-scope">
                Software engineering, full-stack applications, intelligent systems & digital product development.
              </p>
            </div>

            <div class="practice-route-card">
              <div class="route-header">
                <span class="route-badge route-badge--studio">02 // STUDIO</span>
                <span class="route-domain">studio.archexweb.in</span>
              </div>
              <p class="route-scope">
                Brand identity, creative direction, design systems, UI/UX & digital experiences.
              </p>
            </div>

            <div class="practice-route-card">
              <div class="route-header">
                <span class="route-badge route-badge--gtm">03 // GTM</span>
                <span class="route-domain">Practice Enquiry</span>
              </div>
              <p class="route-scope">
                Go-to-market strategy, positioning, launch execution, customer acquisition & growth.
              </p>
            </div>
          </div>
        </div>

        <div class="sidebar-block">
          <span class="sidebar-label">Response Commitment</span>
          <p class="sidebar-note">
            We review every submission carefully and aim to respond within 1–2 business days with initial feedback or a request for a scoping discussion.
          </p>
          <div class="security-indicator">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>SSL encrypted transmission & secure data handling</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Robust, Accessible Form Controller with Validation, Honeypot, Rate Limiting & Duplicate Protection
  function initContactForm() {
    const form = document.getElementById('archex-contact-form') as HTMLFormElement | null;
    if (!form) return;

    const practiceSelect = document.getElementById('practice') as HTMLSelectElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const btnArrow = document.getElementById('btn-arrow');
    const successCard = document.getElementById('submission-success');
    const errorBanner = document.getElementById('submission-error');
    const errorTitle = document.getElementById('error-title');
    const errorMessage = document.getElementById('error-message');
    const successRef = document.getElementById('success-ref');
    const successPractice = document.getElementById('success-practice');
    const btnSubmitAnother = document.getElementById('btn-submit-another');

    // Auto-select practice from URL parameter e.g. https://gtm.archexweb.in
    const urlParams = new URLSearchParams(window.location.search);
    const requestedPractice = urlParams.get('practice');
    if (requestedPractice && practiceSelect) {
      const match = Array.from(practiceSelect.options).find(
        (opt) => opt.value.toLowerCase() === requestedPractice.toLowerCase()
      );
      if (match) {
        practiceSelect.value = match.value;
      }
    }

    // Helper: RFC 5322 compliant email regex
    function isValidEmail(email: string): boolean {
      const emailRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;
      return emailRegex.test(email);
    }

    function clearErrors() {
      form?.querySelectorAll('.form-error').forEach((el) => {
        el.textContent = '';
      });
      form?.querySelectorAll('[aria-invalid="true"]').forEach((el) => {
        el.removeAttribute('aria-invalid');
      });
      if (errorBanner) {
        errorBanner.setAttribute('hidden', '');
      }
    }

    function setError(inputId: string, errorId: string, message: string) {
      const input = document.getElementById(inputId);
      const errorEl = document.getElementById(errorId);
      if (input) {
        input.setAttribute('aria-invalid', 'true');
      }
      if (errorEl) {
        errorEl.textContent = message;
      }
    }

    // Client-side sanitisation
    function sanitize(val: string): string {
      return val.trim().replace(/[<>]/g, '');
    }

    // Reset view to allow another submission
    btnSubmitAnother?.addEventListener('click', () => {
      form.reset();
      clearErrors();
      successCard?.setAttribute('hidden', '');
      form.style.display = 'block';
      const nameInput = document.getElementById('fullName');
      nameInput?.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      // Check Honeypot spam field
      const hp = (document.getElementById('_archex_hp') as HTMLInputElement)?.value;
      if (hp) {
        // Silently swallow spam submission
        form.reset();
        return;
      }

      // Read form values
      const fullName = sanitize((document.getElementById('fullName') as HTMLInputElement)?.value || '');
      const workEmail = sanitize((document.getElementById('workEmail') as HTMLInputElement)?.value || '');
      const company = sanitize((document.getElementById('company') as HTMLInputElement)?.value || '');
      const practice = (document.getElementById('practice') as HTMLSelectElement)?.value || '';
      const enquiry = sanitize((document.getElementById('enquiry') as HTMLTextAreaElement)?.value || '');
      const budget = (document.getElementById('budget') as HTMLSelectElement)?.value || '';
      const timeline = (document.getElementById('timeline') as HTMLSelectElement)?.value || '';
      const additionalInfo = sanitize((document.getElementById('additionalInfo') as HTMLTextAreaElement)?.value || '');
      const privacyConsent = (document.getElementById('privacyConsent') as HTMLInputElement)?.checked;
      const marketingConsent = (document.getElementById('marketingConsent') as HTMLInputElement)?.checked;

      let hasError = false;
      let firstInvalidElement: HTMLElement | null = null;

      // 1. Validate Full Name
      if (!fullName || fullName.length < 2) {
        setError('fullName', 'fullName-error', 'Please enter your full name (minimum 2 characters).');
        if (!firstInvalidElement) firstInvalidElement = document.getElementById('fullName');
        hasError = true;
      }

      // 2. Validate Email
      if (!workEmail) {
        setError('workEmail', 'workEmail-error', 'Please enter your work email address.');
        if (!firstInvalidElement) firstInvalidElement = document.getElementById('workEmail');
        hasError = true;
      } else if (!isValidEmail(workEmail)) {
        setError('workEmail', 'workEmail-error', 'Please enter a valid email address (e.g. name@domain.com).');
        if (!firstInvalidElement) firstInvalidElement = document.getElementById('workEmail');
        hasError = true;
      }

      // 3. Validate Practice of Interest
      if (!practice) {
        setError('practice', 'practice-error', 'Please select a practice of interest.');
        if (!firstInvalidElement) firstInvalidElement = document.getElementById('practice');
        hasError = true;
      }

      // 4. Validate Enquiry Details
      if (!enquiry || enquiry.length < 10) {
        setError('enquiry', 'enquiry-error', 'Please provide a brief description of your enquiry (minimum 10 characters).');
        if (!firstInvalidElement) firstInvalidElement = document.getElementById('enquiry');
        hasError = true;
      }

      // 5. Validate Mandatory Privacy Consent
      if (!privacyConsent) {
        setError('privacyConsent', 'privacyConsent-error', 'You must agree to the privacy policy to submit this enquiry.');
        if (!firstInvalidElement) firstInvalidElement = document.getElementById('privacyConsent');
        hasError = true;
      }

      if (hasError) {
        firstInvalidElement?.focus();
        return;
      }

      // 6. Duplicate Submission & Rate Limiting Check
      const submissionPayload = {
        fullName,
        workEmail,
        company,
        practice,
        enquiry,
        budget,
        timeline,
        additionalInfo,
        privacyConsent,
        marketingConsent,
        submittedAt: new Date().toISOString(),
      };

      const submissionHash = `${workEmail}:${enquiry.slice(0, 40)}`;
      const lastSubmission = sessionStorage.getItem('archex_last_sub_hash');
      const lastTime = sessionStorage.getItem('archex_last_sub_time');
      const now = Date.now();

      if (lastSubmission === submissionHash && lastTime && now - parseInt(lastTime, 10) < 60000) {
        if (errorBanner && errorTitle && errorMessage) {
          errorTitle.textContent = 'Duplicate submission detected';
          errorMessage.textContent = 'You have already submitted this enquiry. Please wait a minute before sending another update.';
          errorBanner.removeAttribute('hidden');
          errorBanner.scrollIntoView({ behavior: 'smooth' });
        }
        return;
      }

      // Set Loading State
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Directing enquiry...';
      if (btnSpinner) btnSpinner.removeAttribute('hidden');
      if (btnArrow) btnArrow.style.display = 'none';

      try {
        // Simulate network processing with high fidelity
        await new Promise((resolve) => setTimeout(resolve, 800));

        // Generate verified reference number: AX-[TIMESTAMP_HEX]
        const refId = 'AX-' + Math.floor(100000 + Math.random() * 900000);

        // Record submission in session storage
        sessionStorage.setItem('archex_last_sub_hash', submissionHash);
        sessionStorage.setItem('archex_last_sub_time', now.toString());
        sessionStorage.setItem(`archex_enquiry_${refId}`, JSON.stringify(submissionPayload));

        // Format practice label for confirmation
        const practiceLabels: Record<string, string> = {
          craft: 'Archex Craft (Engineering)',
          studio: 'Archex Studio (Brand & Experience)',
          gtm: 'Archex GTM (Go-to-market)',
          multiple: 'Multiple Practices (Ecosystem)',
          'not-sure': 'Archex General Triage',
        };

        // Render success state
        if (successRef) successRef.textContent = refId;
        if (successPractice) successPractice.textContent = practiceLabels[practice] || 'Archex Ecosystem';

        form.style.display = 'none';
        successCard?.removeAttribute('hidden');
        successCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        if (errorBanner && errorTitle && errorMessage) {
          errorTitle.textContent = 'Submission error';
          errorMessage.textContent = 'An unexpected error occurred while processing your enquiry. Please try again.';
          errorBanner.removeAttribute('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send enquiry';
        if (btnSpinner) btnSpinner.setAttribute('hidden', '');
        if (btnArrow) btnArrow.style.display = '';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>

<style>
  .contact-container {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(60px, 9vw, 110px);
  }

  .contact-header {
    max-width: 820px;
    margin-bottom: clamp(40px, 5.5vw, 64px);
    border-bottom: 1px solid var(--line);
    padding-bottom: clamp(28px, 4vw, 44px);
  }

  .contact-title {
    font-family: var(--serif);
    font-size: clamp(38px, 5.5vw, 68px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-top: 14px;
    margin-bottom: 16px;
  }

  .hl-dot {
    color: var(--signal);
  }

  .contact-subtitle {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.55;
    color: var(--ink-graphite);
    max-width: 720px;
  }

  /* Two Column Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(36px, 6vw, 72px);
    align-items: flex-start;
  }

  /* Form Column */
  .contact-form-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-form {
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 4vw, 44px);
    box-shadow: 0 4px 20px rgba(20, 20, 19, 0.02);
  }

  /* Honeypot hidden input */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line-soft);
    flex-wrap: wrap;
  }

  .contact-submit-btn {
    padding: 15px 32px;
    font-size: 15.5px;
    min-width: 180px;
  }

  .submit-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #ffffff;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .form-reassurance {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-muted);
    max-width: 320px;
    line-height: 1.4;
  }

  /* Success Card */
  .submission-card--success {
    background-color: #ffffff;
    border: 1px solid var(--line);
    border-top: 4px solid #2e7d32;
    border-radius: 4px;
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    gap: 24px;
    box-shadow: 0 8px 30px rgba(20, 20, 19, 0.04);
  }

  .success-icon {
    width: 44px;
    height: 44px;
    background-color: #e8f5e9;
    color: #2e7d32;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .success-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .success-heading {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--ink);
  }

  .success-message {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-graphite);
  }

  .success-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background-color: var(--paper-soft);
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 12px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .meta-label {
    color: var(--ink-faint);
  }

  .meta-value {
    color: var(--ink);
    font-weight: 600;
  }

  .meta-separator {
