---
// contact.astro — Founder Introduction & Central Contact Gateway
import BaseLayout from '../layouts/BaseLayout.astro';

// Configurable Founder Profile & Content Data
// Easily update biographical details, principles, or destination links here.
const founderProfile = {
  name: 'Kaif',
  role: 'Founder & Principal',
  organization: 'Archex',
  pageTitle: 'About the Founder | Archex',
  pageDescription:
    'Get to know the thinking and philosophy behind Archex and the three practices: Craft, Studio and GTM.',
  heroHeading: 'Every direction has a starting point.',
  heroSubtitle:
    'A personal note on the thinking, philosophy and intentions shaping the Archex ecosystem.',
  tagline: 'Independent thinking. Purposeful execution.',
  focusAreas: [
    'Software Architecture & Systems',
    'Brand Identity & Typographic Form',
    'Go-to-Market & Positioning Strategy',
    'First-Principles Product Design',
  ],
  bioQuote:
    '“Good work comes from understanding the problem before rushing towards the solution.”',
  narrative: [
    'Archex began with an interest in bringing thoughtful ideas into the real world.',
    'What started as a focused interest in building digital experiences has gradually developed into a broader ecosystem spanning engineering, creative direction and go-to-market thinking.',
    'I believe good work comes from understanding the problem before rushing towards the solution. Whether it is a digital product, an identity or a business entering the market, the intention remains the same: make decisions with clarity and execute with purpose.',
    'Archex is an evolving expression of that thinking. It is built to remain focused, disciplined and accountable — prioritizing durable execution and honest craft over agency noise.',
  ],
  philosophyHeading: 'How I think about the work.',
  philosophySubtitle:
    'Three principles that guide decisions across every discipline in the Archex ecosystem.',
  philosophyPillars: [
    {
      index: '01',
      title: 'Build with intention.',
      body: 'Technology should solve a meaningful problem, not simply exist for its own sake.',
      discipline: 'ENGINEERING & SYSTEMS',
    },
    {
      index: '02',
      title: 'Design with clarity.',
      body: 'Good creative work should have meaning, direction and purpose.',
      discipline: 'BRAND & EXPERIENCE',
    },
    {
      index: '03',
      title: 'Move with understanding.',
      body: 'Taking something to market requires more than an idea. It requires positioning, decisions and disciplined execution.',
      discipline: 'GO-TO-MARKET & GROWTH',
    },
  ],
  practicesHeading: 'Translating vision into practice.',
  practicesSubtitle:
    'How this thinking is structured across three complementary disciplines:',
  practices: [
    {
      index: '01',
      name: 'Archex Craft',
      domain: 'craft.archexweb.in',
      url: 'https://craft.archexweb.in/',
      description:
        'Software engineering and digital product development. Thoughtful systems, web applications, and resilient digital architectures.',
      external: true,
    },
    {
      index: '02',
      name: 'Archex Studio',
      domain: 'studio.archexweb.in',
      url: 'https://studio.archexweb.in/',
      description:
        'Brand identity, creative direction and digital experiences built around clarity, typographic poise, and purposeful design.',
      external: true,
    },
    {
      index: '03',
      name: 'Archex GTM',
      domain: 'gtm.archexweb.in',
      url: 'https://gtm.archexweb.in',
      description:
        'Go-to-market strategy and execution to help businesses position, launch and grow their products and services.',
      external: true,
    },
  ],
  contactSection: {
    heading: 'Have something in mind?',
    description:
      'For projects, collaborations, questions or anything you’d like to discuss, reach out through our central contact desk.',
    deskNote: 'All enquiries are handled centrally through Archex Craft.',
    ctaLabel: 'Get in touch',
    destinationUrl: 'https://craft.archexweb.in/contact',
  },
};
---

<BaseLayout
  title={founderProfile.pageTitle}
  description={founderProfile.pageDescription}
  canonical="https://www.archexweb.in/contact/"
  activePath="/contact"
>
  <div class="shell founder-page-container">
    <!-- Hero Section: Eyebrow & Primary Heading -->
    <header class="founder-hero">

      <h1 class="founder-hero-title">
        Every direction has a<br />
        starting point<span class="hl-dot">.</span>
      </h1>

      <p class="founder-hero-subtitle">
        {founderProfile.heroSubtitle}
      </p>
    </header>

    <!-- Main Editorial Founder Introduction Section -->
    <section class="section-wrapper founder-intro-section" aria-labelledby="founder-profile-heading">
      <div class="founder-intro-grid">
        <!-- Left Column: Architectural Profile Card -->
        <aside class="founder-card" aria-label="Founder Identity">
          <div class="founder-card-inner">
            <!-- Architectural Geometric Monogram Seal -->
            <div class="founder-seal" aria-hidden="true">
              <svg class="seal-svg" viewBox="0 0 160 160" fill="none">
                <circle cx="80" cy="80" r="74" stroke="var(--line-strong)" stroke-width="1.5" />
                <circle cx="80" cy="80" r="62" stroke="var(--line-soft)" stroke-width="1" stroke-dasharray="3 3" />
                <circle cx="80" cy="80" r="46" fill="var(--paper-card)" stroke="var(--ink)" stroke-width="1.5" />
                <!-- Coordinates crosshair -->
                <line x1="80" y1="12" x2="80" y2="28" stroke="var(--signal)" stroke-width="1.5" />
                <line x1="80" y1="132" x2="80" y2="148" stroke="var(--signal)" stroke-width="1.5" />
                <line x1="12" y1="80" x2="28" y2="80" stroke="var(--signal)" stroke-width="1.5" />
                <line x1="132" y1="80" x2="148" y2="80" stroke="var(--signal)" stroke-width="1.5" />
                <!-- Monogram Initial -->
                <text x="80" y="93" text-anchor="middle" font-family="var(--serif)" font-size="38" fill="var(--ink)">K<tspan fill="var(--signal)">.</tspan></text>
              </svg>
            </div>

            <!-- Profile Metadata -->
            <div class="founder-identity">
              <h2 id="founder-profile-heading" class="founder-name">{founderProfile.name}</h2>
              <span class="founder-role">{founderProfile.role}</span>
              <span class="founder-org">{founderProfile.organization}</span>
            </div>

            <!-- Quote Anchor -->
            <blockquote class="founder-quote">
              <p>{founderProfile.bioQuote}</p>
            </blockquote>

            <!-- Professional Focus Areas -->
            <div class="founder-focus">
              <span class="focus-title">Professional Focus</span>
              <ul class="focus-list">
                {founderProfile.focusAreas.map((area) => (
                  <li>{area}</li>
                ))}
              </ul>
            </div>
          </div>
        </aside>

        <!-- Right Column: First-Person Narrative Essay -->
        <article class="founder-narrative" aria-label="A personal note from the founder">
          <div class="narrative-tag-row">
            <span class="narrative-label">A NOTE ON ORIGINS & DIRECTION</span>
          </div>

          <div class="narrative-prose">
            {founderProfile.narrative.map((paragraph, idx) => (
              <p class={idx === 0 ? 'lead-paragraph' : ''}>{paragraph}</p>
            ))}
          </div>

          <div class="narrative-signoff">
            <span class="signoff-note">Sincerely,</span>
            <span class="signoff-name">{founderProfile.name}</span>
            <span class="signoff-tagline">{founderProfile.tagline}</span>
          </div>
        </article>
      </div>
    </section>

    <!-- Philosophy Section: How I think about the work -->
    <section class="section-wrapper philosophy-section" id="philosophy" aria-labelledby="philosophy-title">
      <div class="section-intro">
        <span class="tech-tag tech-tag--signal">Foundational Thinking</span>
        <h2 id="philosophy-title" class="section-heading">
          {founderProfile.philosophyHeading}
        </h2>
        <p class="section-subheading">
          {founderProfile.philosophySubtitle}
        </p>
      </div>

      <div class="philosophy-grid">
        {founderProfile.philosophyPillars.map((pillar) => (
          <article class="philosophy-card">
            <div class="pillar-top">
              <span class="pillar-index">{pillar.index}</span>
              <span class="pillar-discipline">{pillar.discipline}</span>
            </div>
            <h3 class="pillar-heading">{pillar.title}</h3>
            <p class="pillar-body">{pillar.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Practices Section: Translating Vision into Practice -->
    <section class="section-wrapper practices-bridge-section" id="practices" aria-labelledby="practices-bridge-title">
      <div class="section-intro">
        <span class="tech-tag">The Ecosystem</span>
        <h2 id="practices-bridge-title" class="section-heading">
          {founderProfile.practicesHeading}
        </h2>
        <p class="section-subheading">
          {founderProfile.practicesSubtitle}
        </p>
      </div>

      <div class="practices-bridge-grid">
        {founderProfile.practices.map((practice) => (
          <article class="practice-bridge-card">
            <div class="bridge-card-top">
              <span class="bridge-index">{practice.index} // PRACTICE</span>
              <a href={practice.url} class="bridge-domain" target="_blank" rel="noopener noreferrer">
                {practice.domain} ↗
              </a>
            </div>
            <h3 class="bridge-title">{practice.name}</h3>
            <p class="bridge-desc">{practice.description}</p>
            <div class="bridge-footer">
              <a href={practice.url} class="bridge-link" target="_blank" rel="noopener noreferrer">
                <span>Explore {practice.name.replace('Archex ', '')}</span>
                <span class="btn-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Compact Central Contact Destination Section -->
    <section class="section-wrapper contact-destination-section" id="contact-desk" aria-labelledby="contact-desk-heading">
      <div class="contact-destination-card">
        <div class="card-glow-bar" aria-hidden="true"></div>

        <div class="destination-header">
          <span class="tech-tag tech-tag--signal">Central Contact Gateway</span>
          <h2 id="contact-desk-heading" class="destination-heading">
            {founderProfile.contactSection.heading}
          </h2>
          <p class="destination-copy">
            {founderProfile.contactSection.description}
          </p>
        </div>

        <div class="destination-action-cluster">
          <!-- Primary CTA strictly navigates in the same tab to craft.archexweb.in/contact -->
          <a
            href={founderProfile.contactSection.destinationUrl}
            class="btn-base btn-primary contact-destination-btn"
            title="Open Central Contact Desk at Archex Craft"
          >
            <span>{founderProfile.contactSection.ctaLabel}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>

          <p class="destination-explainer">
            <span class="explainer-bullet" aria-hidden="true">●</span>
            {founderProfile.contactSection.deskNote}
          </p>
        </div>

        <div class="destination-meta-footer">
          <span class="desk-indicator">Routing destination: <strong>craft.archexweb.in/contact</strong></span>
          <span class="desk-sep" aria-hidden="true">•</span>
          <span class="desk-direct">Direct communication // No marketing automation</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .founder-page-container {
    padding-top: clamp(40px, 6vw, 76px);
    padding-bottom: clamp(60px, 9vw, 110px);
  }

  /* ==========================================================================
     Hero Section
     ========================================================================== */
  .founder-hero {
    max-width: 920px;
    margin-bottom: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(32px, 4.5vw, 48px);
    border-bottom: 1px solid var(--line);
  }

  .hero-tag-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: clamp(20px, 3vw, 28px);
    flex-wrap: wrap;
  }

  .hero-coord-note {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .founder-hero-title {
    font-family: var(--serif);
    font-size: clamp(38px, 5.8vw, 76px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: clamp(20px, 3vw, 28px);
  }

  .hl-dot {
    color: var(--signal);
  }

  .founder-hero-subtitle {
    font-size: clamp(18px, 1.8vw, 23px);
    line-height: 1.5;
    color: var(--ink-graphite);
    max-width: 740px;
  }

  /* ==========================================================================
     Founder Introduction Grid
     ========================================================================== */
  .founder-intro-section {
    padding-top: 0;
    padding-bottom: clamp(56px, 7vw, 92px);
    border-bottom: 1px solid var(--line-soft);
  }

  .founder-intro-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: clamp(36px, 6vw, 72px);
    align-items: flex-start;
  }

  /* Profile Card (Left) */
  .founder-card {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 3vw, 32px);
    box-shadow: 0 4px 20px rgba(20, 20, 19, 0.03);
  }

  .founder-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .founder-seal {
    width: 130px;
    height: 130px;
  }

  .seal-svg {
    width: 100%;
    height: 100%;
  }

  .founder-identity {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .founder-name {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .founder-role {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
    font-weight: 600;
  }

  .founder-org {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-faint);
  }

  .founder-quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-graphite);
    padding: 16px;
    background-color: var(--paper-soft);
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    width: 100%;
  }

  .founder-focus {
    width: 100%;
    text-align: left;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
  }

  .focus-title {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: block;
    margin-bottom: 10px;
  }

  .focus-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .focus-list li {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-soft);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .focus-list li::before {
    content: '—';
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }

  /* Narrative Essay (Right) */
  .founder-narrative {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 720px;
  }

  .narrative-tag-row {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-soft);
  }

  .narrative-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .narrative-prose {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .narrative-prose p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .lead-paragraph {
    font-size: clamp(19px, 1.8vw, 22px) !important;
    line-height: 1.6 !important;
    color: var(--ink) !important;
    font-weight: 400;
  }

  .narrative-signoff {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .signoff-note {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .signoff-name {
    font-family: var(--serif);
    font-size: 24px;
    color: var(--ink);
  }

  .signoff-tagline {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--signal);
    text-transform: uppercase;
  }

  /* ==========================================================================
     Philosophy Section: "How I think about the work"
     ========================================================================== */
  .philosophy-section {
    border-bottom: 1px solid var(--line-soft);
  }

  .section-intro {
    max-width: 820px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .section-heading {
    font-family: var(--serif);
    font-size: clamp(30px, 3.8vw, 46px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 14px;
    margin-bottom: 12px;
  }

  .section-subheading {
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--ink-graphite);
    line-height: 1.5;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 32px);
    align-items: stretch;
  }

  .philosophy-card {
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .philosophy-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }

  .pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-soft);
  }

  .pillar-index {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--signal);
    font-weight: 600;
  }

  .pillar-discipline {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .pillar-heading {
    font-family: var(--serif);
    font-size: clamp(21px, 1.9vw, 25px);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .pillar-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-graphite);
  }

  /* ==========================================================================
     Practices Bridge Section
     ========================================================================== */
  .practices-bridge-section {
    border-bottom: 1px solid var(--line-soft);
  }

  .practices-bridge-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 32px);
    align-items: stretch;
  }

  .practice-bridge-card {
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(22px, 2.8vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .practice-bridge-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .bridge-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-soft);
  }

  .bridge-index {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
    font-weight: 600;
  }

  .bridge-domain {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
    transition: color var(--transition-fast);
  }

  .bridge-domain:hover {
    color: var(--signal);
  }

  .bridge-title {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 400;
    color: var(--ink);
  }

  .bridge-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-graphite);
    margin-bottom: auto;
  }

  .bridge-footer {
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }

  .bridge-link {
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition-fast);
  }

  .bridge-link:hover {
    color: var(--signal);
  }

  /* ==========================================================================
     Central Contact Destination Section
     ========================================================================== */
  .contact-destination-section {
    padding-top: clamp(48px, 7vw, 84px);
    padding-bottom: clamp(60px, 8vw, 100px);
  }

  .contact-destination-card {
    background-color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(36px, 6vw, 68px) clamp(24px, 5vw, 64px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .card-glow-bar {
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--signal), transparent);
  }

  .destination-header {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .destination-heading {
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .destination-copy {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--ink-graphite);
    max-width: 600px;
  }

  .destination-action-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .contact-destination-btn {
    padding: 16px 40px;
    font-size: 16px;
    box-shadow: 0 4px 16px rgba(20, 20, 19, 0.08);
  }

  .destination-explainer {
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .explainer-bullet {
    color: var(--signal);
    font-size: 8px;
  }

  .destination-meta-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px dashed var(--line);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-faint);
