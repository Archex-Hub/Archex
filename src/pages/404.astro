---
// 404.astro — Custom Not Found Page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Archex"
  description="The page you are looking for does not exist. Explore Archex Craft, Archex Studio, or contact Archex."
  canonical="https://www.archexweb.in/404/"
>
  <div class="shell not-found-shell">
    <div class="not-found-card">
      <span class="tech-tag tech-tag--signal">Error 404 // Direction Not Found</span>
      <h1 class="not-found-title">Page not found<span class="hl-dot">.</span></h1>
      <p class="not-found-desc">
        The link you followed may be outdated, or the address may have moved during our brand restructuring.
      </p>

      <div class="not-found-actions">
        <a href="/" class="btn-base btn-primary">
          <span>Return to Homepage</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="https://craft.archexweb.in/contact" class="btn-base btn-secondary">
          <span>Contact Archex</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="not-found-destinations">
        <span class="dest-label">Explore Archex Practices:</span>
        <div class="dest-links">
          <a href="https://craft.archexweb.in/" class="dest-pill" target="_blank" rel="noopener noreferrer">
            Archex Craft ↗
          </a>
          <a href="https://studio.archexweb.in/" class="dest-pill" target="_blank" rel="noopener noreferrer">
            Archex Studio ↗
          </a>
          <a href="https://gtm.archexweb.in" class="dest-pill">
            Archex GTM →
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-shell {
    padding-top: clamp(60px, 10vw, 120px);
    padding-bottom: clamp(60px, 10vw, 120px);
    display: flex;
    justify-content: center;
  }

  .not-found-card {
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(36px, 6vw, 64px) clamp(24px, 5vw, 56px);
    max-width: 640px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    box-shadow: 0 8px 30px rgba(20, 20, 19, 0.03);
  }

  .not-found-title {
    font-family: var(--serif);
    font-size: clamp(34px, 4.8vw, 54px);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .hl-dot {
    color: var(--signal);
  }

  .not-found-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-graphite);
    max-width: 480px;
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
    width: 100%;
  }

  .not-found-destinations {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px dashed var(--line);
    width: 100%;
  }

  .dest-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .dest-links {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .dest-pill {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-soft);
    padding: 6px 12px;
    background-color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 2px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .dest-pill:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  @media (max-width: 500px) {
    .not-found-actions {
      flex-direction: column;
    }
    .not-found-actions .btn-base {
      width: 100%;
    }
  }
</style>

