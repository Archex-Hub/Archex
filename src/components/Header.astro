---
// Header.astro — Minimalist, refined gateway navigation
---

<header class="site-header" role="banner">
  <div class="shell header-inner">
    <div class="header-brand">
      <a href="#top" class="wordmark" aria-label="Archex — Back to top">
        archex<span class="wordmark-dot">.</span>
      </a>
      <span class="header-badge" aria-hidden="true">Gateway</span>
    </div>

    <nav class="header-nav" aria-label="Primary destinations">
      <ul class="nav-list">
        <li class="nav-item">
          <a
            href="https://craft.archexweb.in/"
            class="nav-link nav-link--craft"
            title="Go to Archex Craft — Digital Products & Engineering"
          >
            <span class="nav-label">Craft</span>
            <span class="nav-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li class="nav-separator" aria-hidden="true">/</li>
        <li class="nav-item">
          <a
            href="https://studio.archexweb.in/"
            class="nav-link nav-link--studio"
            title="Explore Archex Studio — Brand & Digital Experience"
          >
            <span class="nav-label">Studio</span>
            <span class="nav-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(245, 242, 235, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .header-brand {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: clamp(23px, 2.4vw, 28px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    transition: opacity var(--transition-fast);
  }

  .wordmark:hover {
    opacity: 0.85;
  }

  .wordmark-dot {
    color: var(--signal);
    font-family: var(--serif);
  }

  .header-badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 2px 6px;
    border: 1px solid var(--line-soft);
    border-radius: 2px;
    display: inline-block;
  }

  .header-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.8vw, 20px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-separator {
    color: var(--line);
    font-family: var(--mono);
    font-size: 13px;
    user-select: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--sans);
    font-size: clamp(14px, 1.3vw, 15px);
    font-weight: 500;
    color: var(--ink-soft);
    padding: 8px 10px;
    border-radius: 2px;
    position: relative;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 10px;
    right: 14px;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-smooth);
  }

  .nav-link:hover {
    color: var(--signal);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-arrow {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .nav-link:hover .nav-arrow {
    transform: translate(2px, -2px);
    color: var(--signal);
  }

  /* Specific mobile adjustments */
  @media (max-width: 480px) {
    .header-badge {
      display: none;
    }
    .nav-list {
      gap: 6px;
    }
    .nav-link {
      padding: 6px 6px;
    }
  }
</style>

