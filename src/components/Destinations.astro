---
// Destinations.astro — Distinctive asymmetric presentation of the two practice destinations
---

<section class="section-wrapper destinations" id="destinations" aria-labelledby="destinations-title">
  <div class="shell">
    <!-- Section Introduction Header -->
    <div class="dest-section-header">
      <div class="header-left">
        <span class="tech-tag">Two Practice Destinations</span>
        <h2 id="destinations-title" class="dest-heading">
          Where the work continues.
        </h2>
      </div>
      <p class="editorial-note header-quote">
        “Different disciplines. A shared point of view.”
      </p>
    </div>

    <!-- Asymmetric Destinations Grid -->
    <div class="destinations-grid">
      <!-- ===================================================================
           DESTINATION 01: ARCHEX CRAFT (PRIMARY EMPHASIS)
           =================================================================== -->
      <article class="dest-card dest-card--craft" aria-labelledby="craft-title">
        <div class="card-inner">
          <!-- Card Header & Metadata -->
          <div class="card-top-row">
            <span class="card-index">01 / DIGITAL PRODUCTS & ENGINEERING</span>
            <span class="card-status-badge">Primary Destination</span>
          </div>

          <!-- Main Text Content -->
          <div class="card-body">
            <h3 id="craft-title" class="card-title">
              Archex Craft<span class="card-period">.</span>
            </h3>
            <p class="card-description">
              From product ideas to working software. Craft is the new home of Archex Web's digital product and engineering work.
            </p>

            <div class="card-actions">
              <a
                href="https://craft.archexweb.in/"
                class="btn-base btn-primary dest-cta dest-cta--craft"
                title="Visit Archex Craft — Digital Products & Engineering"
              >
                <span>Visit Craft</span>
                <span class="btn-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <!-- Modular Architectural SVG Graphic -->
          <div class="card-graphic card-graphic--craft" aria-hidden="true">
            <svg class="craft-svg" viewBox="0 0 460 220" fill="none">
              <!-- Coordinate Grid System -->
              <defs>
                <pattern id="craft-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(20, 26, 40, 0.06)" stroke-width="0.75" />
                </pattern>
              </defs>
              <rect width="460" height="220" fill="url(#craft-grid)" />

              <!-- Technical Markers & Ruler ticks -->
              <line x1="20" y1="20" x2="440" y2="20" stroke="var(--line)" stroke-width="1" />
              <line x1="20" y1="16" x2="20" y2="24" stroke="var(--ink)" stroke-width="1.5" />
              <line x1="125" y1="18" x2="125" y2="22" stroke="var(--ink-muted)" stroke-width="1" />
              <line x1="230" y1="16" x2="230" y2="24" stroke="var(--signal)" stroke-width="1.5" />
              <line x1="335" y1="18" x2="335" y2="22" stroke="var(--ink-muted)" stroke-width="1" />
              <line x1="440" y1="16" x2="440" y2="24" stroke="var(--ink)" stroke-width="1.5" />

              <!-- Architectural Component Modules -->
              <!-- Module 1: Core Systems -->
              <rect x="30" y="45" width="115" height="135" rx="3" fill="#ffffff" stroke="var(--line-strong)" stroke-width="1.5" />
              <rect x="42" y="58" width="55" height="7" rx="1" fill="var(--ink)" />
              <line x1="42" y1="78" x2="133" y2="78" stroke="var(--line-soft)" stroke-width="1" />
              <rect x="42" y="90" width="90" height="20" rx="2" fill="var(--paper-soft)" stroke="var(--line)" stroke-width="1" />
              <text x="50" y="104" font-family="var(--mono)" font-size="8" fill="var(--ink-graphite)" letter-spacing="1">SYSTEMS</text>
              <rect x="42" y="120" width="90" height="20" rx="2" fill="var(--paper-soft)" stroke="var(--line)" stroke-width="1" />
              <text x="50" y="134" font-family="var(--mono)" font-size="8" fill="var(--ink-graphite)" letter-spacing="1">RUNTIME</text>
              <circle cx="128" cy="165" r="3" fill="var(--signal)" />
              <text x="42" y="167" font-family="var(--mono)" font-size="7" fill="var(--ink-faint)">NODE_01</text>

              <!-- Connector Bus Lines -->
              <path d="M 145 100 L 180 100 L 180 85 L 210 85" stroke="var(--signal)" stroke-width="1.5" stroke-dasharray="3 3" />
              <circle cx="145" cy="100" r="2.5" fill="var(--signal)" />
              <circle cx="210" cy="85" r="2.5" fill="var(--signal)" />

              <path d="M 145 130 L 195 130 L 195 145 L 210 145" stroke="var(--craft-accent)" stroke-width="1.5" />
              <circle cx="145" cy="130" r="2.5" fill="var(--craft-accent)" />
              <circle cx="210" cy="145" r="2.5" fill="var(--craft-accent)" />

              <!-- Module 2: Intelligence & Engineering Engine -->
              <rect x="210" y="65" width="130" height="115" rx="3" fill="#ffffff" stroke="var(--craft-accent)" stroke-width="1.5" />
              <rect x="222" y="78" width="70" height="7" rx="1" fill="var(--craft-ink)" />
              <line x1="222" y1="96" x2="328" y2="96" stroke="var(--line-soft)" stroke-width="1" />
              <circle cx="230" cy="115" r="8" fill="var(--craft-tint)" stroke="var(--craft-accent)" stroke-width="1" />
              <text x="246" y="118" font-family="var(--mono)" font-size="8" fill="var(--craft-ink)">ENGINEERING</text>
              <rect x="222" y="134" width="105" height="28" rx="2" fill="var(--paper)" stroke="var(--line)" stroke-width="1" />
              <text x="232" y="151" font-family="var(--mono)" font-size="7.5" fill="var(--signal)">ACTIVE // BUILD</text>

              <!-- Connector to Output Stage -->
              <line x1="340" y1="120" x2="375" y2="120" stroke="var(--line-strong)" stroke-width="1.5" />
              <polygon points="375,117 381,120 375,123" fill="var(--line-strong)" />

              <!-- Module 3: Digital Product Result -->
              <rect x="382" y="80" width="58" height="85" rx="3" fill="#ffffff" stroke="var(--line-strong)" stroke-width="1" />
              <rect x="390" y="92" width="42" height="4" rx="1" fill="var(--signal)" />
              <rect x="390" y="103" width="42" height="18" rx="1" fill="var(--paper-soft)" />
              <rect x="390" y="128" width="42" height="24" rx="1" fill="var(--paper-soft)" />
            </svg>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           DESTINATION 02: ARCHEX STUDIO (EDITORIAL & EXPERIENCE)
           =================================================================== -->
      <article class="dest-card dest-card--studio" aria-labelledby="studio-title">
        <div class="card-inner">
          <!-- Card Header & Metadata -->
          <div class="card-top-row">
            <span class="card-index">02 / BRAND & DIGITAL EXPERIENCE</span>
            <span class="card-status-badge card-status-badge--studio">Creative Practice</span>
          </div>

          <!-- Main Text Content -->
          <div class="card-body">
            <h3 id="studio-title" class="card-title">
              Archex Studio<span class="card-period">.</span>
            </h3>
            <p class="card-description">
              An independent creative practice shaping identities, visual systems and digital experiences.
            </p>

            <div class="card-actions">
              <a
                href="https://studio.archexweb.in/"
                class="btn-base btn-secondary dest-cta dest-cta--studio"
                title="Visit Archex Studio — Brand & Digital Experience"
              >
                <span>Visit Studio</span>
                <span class="btn-arrow" aria-hidden="true">↗</span>
              </a>

              <a
                href="https://studio.archexweb.in/work/"
                class="studio-archive-link"
                title="Explore selected work at Archex Studio"
              >
                <span>Explore selected work</span>
                <span class="link-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <!-- Editorial / Identity-Led SVG Graphic -->
          <div class="card-graphic card-graphic--studio" aria-hidden="true">
            <svg class="studio-svg" viewBox="0 0 380 180" fill="none">
              <!-- Golden Section & Geometric Identity Curves -->
              <rect x="15" y="15" width="350" height="150" rx="2" stroke="var(--line)" stroke-width="1" stroke-dasharray="4 4" />
              
              <!-- Serif Ligature Arc & Proportional Lines -->
              <circle cx="190" cy="90" r="60" stroke="var(--line-soft)" stroke-width="1" />
              <circle cx="190" cy="90" r="38" stroke="var(--line)" stroke-width="1" />
              <line x1="190" y1="20" x2="190" y2="160" stroke="var(--line)" stroke-width="0.75" />
              <line x1="60" y1="90" x2="320" y2="90" stroke="var(--line)" stroke-width="0.75" />

              <!-- Editorial Typographic Mark Composition -->
              <text x="140" y="104" font-family="var(--serif)" font-size="44" fill="var(--ink)" letter-spacing="-1">Ax</text>
              <circle cx="218" cy="100" r="4.5" fill="var(--signal)" />

              <!-- Refined Annotation Markers -->
              <text x="30" y="38" font-family="var(--mono)" font-size="8" fill="var(--ink-faint)" letter-spacing="1">VISUAL SYSTEM</text>
              <text x="30" y="152" font-family="var(--mono)" font-size="8" fill="var(--ink-faint)" letter-spacing="1">PROPORTION // 1.618</text>
              <text x="280" y="38" font-family="var(--mono)" font-size="8" fill="var(--signal)" letter-spacing="1">IDENTITY</text>
            </svg>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .destinations {
    background-color: var(--paper-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .dest-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 56px);
    flex-wrap: wrap;
  }

  .dest-heading {
    font-family: var(--serif);
    font-size: clamp(30px, 3.8vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 12px;
  }

  .header-quote {
    max-width: 320px;
  }

  /* Grid: Asymmetric Layout */
  .destinations-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(24px, 3.5vw, 40px);
    align-items: stretch;
  }

  /* Base Card Styles */
  .dest-card {
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth), border-color var(--transition-smooth);
  }

  .dest-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(20, 20, 19, 0.05);
    border-color: var(--line-strong);
  }

  /* Primary Card (Craft) styling */
  .dest-card--craft {
    border-width: 1.5px;
    border-color: var(--line-strong);
    background: linear-gradient(180deg, #ffffff 0%, var(--paper-card) 100%);
  }

  .card-inner {
    padding: clamp(24px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 28px;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .card-index {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--ink-graphite);
    text-transform: uppercase;
  }

  .card-status-badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
    background-color: var(--signal-tint);
    border: 1px solid rgba(156, 62, 47, 0.2);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .card-status-badge--studio {
    color: var(--ink-graphite);
    background-color: rgba(20, 20, 19, 0.04);
    border-color: var(--line);
  }

  .card-title {
    font-family: var(--serif);
    font-size: clamp(32px, 3.4vw, 44px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 14px;
    line-height: 1.15;
  }

  .card-period {
    color: var(--signal);
  }

  .card-description {
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.55;
    color: var(--ink-graphite);
    margin-bottom: 24px;
    max-width: 500px;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .dest-cta {
    padding: 13px 22px;
  }

  .dest-url-pill {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.03em;
  }

  .studio-archive-link {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink-graphite);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--line);
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .studio-archive-link:hover {
    color: var(--signal);
    text-decoration-color: var(--signal);
  }

  /* Graphics */
  .card-graphic {
    width: 100%;
    margin-top: auto;
    border: 1px solid var(--line-soft);
    border-radius: 2px;
    background-color: var(--paper-soft);
    overflow: hidden;
  }

  .craft-svg, .studio-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .destinations-grid {
      grid-template-columns: 1fr;
    }
    .dest-section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>

