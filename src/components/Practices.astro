---
// Practices.astro — The Three Core Practices of Archex: Craft, Studio, GTM
// High-Impact Editorial & Tactile Practice Showcases Driving High CTR
---

<section class="section-wrapper practices-section" id="practices" aria-labelledby="practices-title">
  <div class="shell">
    <!-- Section Introduction Header -->
    <div class="section-header">
      <div class="header-left">
        <span class="tech-tag tech-tag--signal">Three Disciplines · One Ecosystem</span>
        <h2 id="practices-title" class="section-heading">
          Our practices<span class="hl-dot">.</span>
        </h2>
      </div>
      <div class="header-right">
        <p class="editorial-note section-quote">
          “Three complementary disciplines. Engaging independently or together.”
        </p>
        <p class="section-subtext">
          Select any practice below to explore its dedicated environment, case work, and capabilities.
        </p>
      </div>
    </div>

    <!-- The 3 Practice Cards Grid -->
    <div class="practices-grid">
      <!-- ===================================================================
           CARD 1: ARCHEX CRAFT (Engineering & Technology)
           =================================================================== -->
      <article class="practice-card practice-card--craft" aria-labelledby="craft-title">
        <div class="card-inner">
          <!-- Card Header -->
          <div class="card-header">
            <div class="card-meta">
              <span class="card-index">01 / ENGINEERING & TECHNOLOGY</span>
              <span class="live-beacon live-beacon--craft">
                <span class="beacon-pulse" aria-hidden="true"></span>
                <span>Live System</span>
              </span>
            </div>
            <h3 id="craft-title" class="card-title">
              Craft<span class="card-period card-period--craft">.</span>
            </h3>
            <span class="card-subtitle">Websites, Software & AI Automation</span>
          </div>

          <!-- Card Body -->
          <div class="card-body">
            <p class="card-description">
              Thoughtful software engineering and digital product development, from early ideas to reliable digital systems.
            </p>

            <!-- Value Blueprint Preview Specimen -->
            <div class="card-specimen card-specimen--craft" aria-label="Craft Engineering Value">
              <div class="specimen-topbar">
                <span class="specimen-label">WHAT WE DELIVER</span>
                <span class="specimen-tag">FAST & RELIABLE</span>
              </div>
              
              <div class="blueprint-stack">
                <div class="stack-item">
                  <div class="stack-dot" aria-hidden="true"></div>
                  <div class="stack-text">
                    <span class="stack-name">01 Fast Websites & Apps</span>
                    <span class="stack-detail">Loads instantly on any phone, tablet, or laptop</span>
                  </div>
                </div>
                <div class="stack-item">
                  <div class="stack-dot" aria-hidden="true"></div>
                  <div class="stack-text">
                    <span class="stack-name">02 Custom Software</span>
                    <span class="stack-detail">Secure, bug-free tools built for your team</span>
                  </div>
                </div>
                <div class="stack-item">
                  <div class="stack-dot" aria-hidden="true"></div>
                  <div class="stack-text">
                    <span class="stack-name">03 Smart Automation</span>
                    <span class="stack-detail">Helpful AI tools that save hours of daily work</span>
                  </div>
                </div>
              </div>

              <!-- Architectural Vector Graphic -->
              <div class="card-graphic" aria-hidden="true">
                <svg class="practice-svg" viewBox="0 0 320 80" fill="none">
                  <rect x="5" y="5" width="310" height="70" rx="3" stroke="rgba(245, 158, 11, 0.2)" stroke-width="1" stroke-dasharray="2 3" />
                  <rect x="20" y="20" width="70" height="40" rx="2" fill="rgba(245, 158, 11, 0.08)" stroke="#f59e0b" stroke-width="1.2" />
                  <text x="30" y="44" font-family="var(--mono)" font-size="8" fill="#f59e0b" letter-spacing="1">SYSTEM</text>
                  
                  <line x1="90" y1="40" x2="135" y2="40" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="3 3" />
                  <polygon points="133,37 139,40 133,43" fill="#f59e0b" />
                  
                  <rect x="140" y="20" width="75" height="40" rx="2" fill="rgba(255, 255, 255, 0.05)" stroke="rgba(255, 255, 255, 0.3)" stroke-width="1.2" />
                  <text x="150" y="44" font-family="var(--mono)" font-size="8" fill="#ffffff" letter-spacing="1">RUNTIME</text>
                  
                  <line x1="215" y1="40" x2="250" y2="40" stroke="rgba(255, 255, 255, 0.3)" stroke-width="1.5" />
                  <polygon points="248,37 254,40 248,43" fill="#ffffff" />
                  
                  <circle cx="275" cy="40" r="14" fill="rgba(245, 158, 11, 0.1)" stroke="#f59e0b" stroke-width="1.2" />
                  <circle cx="275" cy="40" r="4" fill="#f59e0b" />
                </svg>
              </div>
            </div>

            <!-- Core Capabilities List -->
            <div class="card-capabilities">
              <span class="capabilities-title">Core capabilities</span>
              <ul class="capabilities-list">
                <li>Software engineering</li>
                <li>Web applications</li>
                <li>Digital products</li>
                <li>AI integration</li>
                <li>Systems and modernization</li>
              </ul>
            </div>
          </div>

          <!-- Card Footer & High-CTR Magnetic CTA -->
          <div class="card-footer">
            <a
              href="https://craft.archexweb.in/"
              class="btn-base card-cta card-cta--craft"
              title="Explore Archex Craft — Digital Products & Engineering"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Explore Craft</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="card-destination-meta">
              <span class="card-url-hint">craft.archexweb.in</span>
              <span class="card-status-badge">Software · Systems · AI</span>
            </div>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           CARD 2: ARCHEX STUDIO (Brand & Experience)
           =================================================================== -->
      <article class="practice-card practice-card--studio" aria-labelledby="studio-title">
        <div class="card-inner">
          <!-- Card Header -->
          <div class="card-header">
            <div class="card-meta">
              <span class="card-index">02 / BRAND & EXPERIENCE</span>
              <span class="live-beacon live-beacon--studio">
                <span class="beacon-pulse" aria-hidden="true"></span>
                <span>Live Archive</span>
              </span>
            </div>
            <h3 id="studio-title" class="card-title">
              Studio<span class="card-period card-period--studio">.</span>
            </h3>
            <span class="card-subtitle">Brand Identity, UI/UX & Digital Design</span>
          </div>

          <!-- Card Body -->
          <div class="card-body">
            <p class="card-description">
              Brand identity, creative direction and digital experiences built around clarity, meaning and thoughtful design.
            </p>

            <!-- Value Specimen Preview Specimen -->
            <div class="card-specimen card-specimen--studio" aria-label="Studio Design Value">
              <div class="specimen-topbar">
                <span class="specimen-label">WHAT WE DELIVER</span>
                <span class="specimen-tag">PREMIUM LOOK</span>
              </div>

              <div class="studio-type-showcase">
                <div class="type-wordmark">clean.<br />trusted.</div>
                <div class="type-metrics">
                  <span class="metric-line"><b>Identity:</b> Logos & Colors</span>
                  <span class="metric-line"><b>Screens:</b> Clean, Easy UI/UX</span>
                  <span class="metric-line"><b>Impression:</b> Builds Instant Trust</span>
                </div>
              </div>

              <!-- Typographic Vector Graphic -->
              <div class="card-graphic" aria-hidden="true">
                <svg class="practice-svg" viewBox="0 0 320 80" fill="none">
                  <rect x="5" y="5" width="310" height="70" rx="3" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3" />
                  
                  <circle cx="60" cy="40" r="24" stroke="var(--line-strong)" stroke-width="1" />
                  <circle cx="60" cy="40" r="14" stroke="var(--line-soft)" stroke-width="0.75" />
                  <text x="50" y="46" font-family="var(--serif)" font-size="18" fill="var(--ink)">Ax</text>
                  <circle cx="76" cy="45" r="2.5" fill="var(--signal)" />

                  <path d="M 95 40 C 140 20, 160 60, 205 35" stroke="var(--signal)" stroke-width="1.5" />
                  <polygon points="203,32 209,35 203,38" fill="var(--signal)" />

                  <rect x="215" y="18" width="90" height="44" rx="2" fill="#ffffff" stroke="var(--line-strong)" stroke-width="1" />
                  <text x="225" y="32" font-family="var(--mono)" font-size="7" fill="var(--ink-faint)" letter-spacing="1">TYPOGRAPHY</text>
                  <text x="225" y="48" font-family="var(--serif)" font-size="12" fill="var(--ink)">Instrument.</text>
                  <line x1="225" y1="53" x2="285" y2="53" stroke="var(--signal)" stroke-width="1" />
                </svg>
              </div>
            </div>

            <!-- Core Capabilities List -->
            <div class="card-capabilities">
              <span class="capabilities-title">Core capabilities</span>
              <ul class="capabilities-list">
                <li>Brand strategy</li>
                <li>Visual identity</li>
                <li>Creative direction</li>
                <li>UI/UX design</li>
                <li>Digital experiences</li>
              </ul>
            </div>
          </div>

          <!-- Card Footer & High-CTR Magnetic CTA -->
          <div class="card-footer">
            <a
              href="https://studio.archexweb.in/"
              class="btn-base card-cta card-cta--studio"
              title="Explore Archex Studio — Brand & Digital Experience"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Explore Studio</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="card-destination-meta">
              <span class="card-url-hint">studio.archexweb.in</span>
              <span class="card-status-badge">Identity · Direction · UI/UX</span>
            </div>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           CARD 3: ARCHEX GTM (Go-to-Market & Growth)
           =================================================================== -->
      <article class="practice-card practice-card--gtm" aria-labelledby="gtm-title">
        <div class="card-inner">
          <!-- Card Header -->
          <div class="card-header">
            <div class="card-meta">
              <span class="card-index">03 / GO-TO-MARKET & GROWTH</span>
              <span class="live-beacon live-beacon--gtm">
                <span class="beacon-pulse" aria-hidden="true"></span>
                <span>Under Development</span>
              </span>
            </div>
            <h3 id="gtm-title" class="card-title">
              GTM<span class="card-period card-period--gtm">.</span>
            </h3>
            <span class="card-subtitle">Go-To-Market, Launch & Sales Growth</span>
          </div>

          <!-- Card Body -->
          <div class="card-body">
            <p class="card-description">
              Go-to-market strategy and execution to help businesses position, launch and grow their products and services.
            </p>

            <!-- Value Acceleration Specimen Preview -->
            <div class="card-specimen card-specimen--gtm" aria-label="GTM Market Acceleration Value">
              <div class="specimen-topbar">
                <span class="specimen-label">WHAT WE DELIVER</span>
                <span class="specimen-tag">REAL CUSTOMERS</span>
              </div>

              <div class="gtm-velocity-grid">
                <div class="velocity-pill">
                  <span class="v-step">01 POSITION</span>
                  <span class="v-val">Clear Offer</span>
                </div>
                <div class="velocity-pill">
                  <span class="v-step">02 LAUNCH</span>
                  <span class="v-val">Strong Buzz</span>
                </div>
                <div class="velocity-pill is-active">
                  <span class="v-step">03 SCALE</span>
                  <span class="v-val">Steady Sales</span>
                </div>
              </div>

              <!-- Market Vector Graphic -->
              <div class="card-graphic" aria-hidden="true">
                <svg class="practice-svg" viewBox="0 0 320 80" fill="none">
                  <rect x="5" y="5" width="310" height="70" rx="3" stroke="rgba(56, 189, 248, 0.2)" stroke-width="1" stroke-dasharray="2 3" />
                  
                  <line x1="30" y1="62" x2="280" y2="62" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" />
                  <line x1="30" y1="18" x2="30" y2="62" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" />
                  
                  <path d="M 30 58 C 90 54, 150 42, 260 22" stroke="#38bdf8" stroke-width="2" />
                  <circle cx="260" cy="22" r="3.5" fill="#38bdf8" />
                  <polygon points="268,19 274,22 268,25" fill="#38bdf8" />

                  <circle cx="90" cy="55" r="2.5" fill="#ffffff" />
                  <text x="80" y="70" font-family="var(--mono)" font-size="6.5" fill="rgba(255,255,255,0.6)">POSITION</text>

                  <circle cx="160" cy="45" r="2.5" fill="#ffffff" />
                  <text x="152" y="70" font-family="var(--mono)" font-size="6.5" fill="rgba(255,255,255,0.6)">LAUNCH</text>

                  <circle cx="230" cy="29" r="2.5" fill="#38bdf8" />
                  <text x="224" y="70" font-family="var(--mono)" font-size="6.5" fill="#38bdf8">SCALE</text>
                </svg>
              </div>
            </div>

            <!-- Core Capabilities List -->
            <div class="card-capabilities">
              <span class="capabilities-title">Core capabilities</span>
              <ul class="capabilities-list capabilities-list--gtm">
                <li>Market research</li>
                <li>Ideal customer profiling</li>
                <li>Positioning and differentiation</li>
                <li>Pricing and packaging</li>
                <li>Launch strategy</li>
                <li>Customer acquisition</li>
                <li>Growth experiments</li>
                <li>Funnel optimisation</li>
              </ul>
            </div>
          </div>

          <!-- Card Footer & High-CTR Magnetic CTA -->
          <div class="card-footer">
            <a
              href="https://gtm.archexweb.in"
              class="btn-base card-cta card-cta--gtm"
              title="Enquire about Archex GTM — Go-to-market Strategy & Execution"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Explore GTM</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="card-destination-meta">
              <span class="card-url-hint">gtm.archexweb.in</span>
              <span class="card-status-badge">Positioning · Traction · Scale</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .practices-section {
    background-color: var(--paper-soft);
    border-bottom: 1px solid var(--line-soft);
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(60px, 8vw, 100px);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(36px, 5vw, 60px);
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-heading {
    font-family: var(--serif);
    font-size: clamp(34px, 4.5vw, 56px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .header-right {
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-quote {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }

  .section-subtext {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-muted);
    margin: 0;
  }

  /* ── 3-Column Practices Grid ───────────────────────────────────────── */
  .practices-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 32px);
    align-items: stretch;
  }

  .practice-card {
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 12px;
  }

  /* ── Card 1: Craft Obsidian Theme ─────────────────────────────────── */
  .practice-card--craft {
    background: #0b0d14;
    color: #ffffff;
    border: 1px solid rgba(245, 158, 11, 0.25);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.35);
  }

  .practice-card--craft:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.55);
    box-shadow: 0 20px 40px -12px rgba(245, 158, 11, 0.2);
  }

  .card-period--craft {
    color: #f59e0b;
  }

  /* ── Card 2: Studio Paper Theme ───────────────────────────────────── */
  .practice-card--studio {
    background: #fdfcf9;
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.08);
  }

  .practice-card--studio:hover {
    transform: translateY(-4px);
    border-color: var(--signal);
    box-shadow: 0 20px 36px -12px rgba(156, 62, 47, 0.15);
  }

  .card-period--studio {
    color: var(--signal);
  }

  /* ── Card 3: GTM Titanium Theme ───────────────────────────────────── */
  .practice-card--gtm {
    background: #11141c;
    color: #ffffff;
    border: 1px solid rgba(56, 189, 248, 0.25);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.35);
  }

  .practice-card--gtm:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 20px 40px -12px rgba(56, 189, 248, 0.2);
  }

  .card-period--gtm {
    color: #38bdf8;
  }

  /* ── Common Card Header ───────────────────────────────────────────── */
  .card-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .practice-card--studio .card-header {
    border-bottom-color: var(--line-soft);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card-index {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
  }

  .practice-card--studio .card-index {
    color: var(--signal);
  }

  .live-beacon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    padding: 2px 7px;
    border-radius: 9999px;
  }

  .live-beacon--craft {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .live-beacon--studio {
    background: rgba(156, 62, 47, 0.1);
    color: var(--signal);
    border: 1px solid rgba(156, 62, 47, 0.25);
  }

  .live-beacon--gtm {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .beacon-pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .card-title {
    font-family: var(--serif);
    font-size: clamp(32px, 3.2vw, 44px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .card-subtitle {
    font-family: var(--sans);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .practice-card--studio .card-subtitle {
    color: var(--ink-graphite);
  }

  /* ── Card Body ────────────────────────────────────────────────────── */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-grow: 1;
  }

  .card-description {
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .practice-card--studio .card-description {
    color: var(--ink-graphite);
  }

  /* ── Specimen Showcase Containers ─────────────────────────────────── */
  .card-specimen {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-specimen--studio {
    background: var(--paper-soft);
    border-color: var(--line-soft);
  }

  .specimen-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
  }

  .card-specimen--studio .specimen-topbar {
    color: var(--ink-muted);
  }

  .specimen-tag {
    color: #f59e0b;
  }

  .card-specimen--studio .specimen-tag {
    color: var(--signal);
  }

  .card-specimen--gtm .specimen-tag {
    color: #38bdf8;
  }

  /* Craft Stack */
  .blueprint-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 6px 10px;
    border-radius: 5px;
    border: 1px solid rgba(245, 158, 11, 0.1);
  }

  .stack-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #f59e0b;
  }

  .stack-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .stack-name {
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 600;
    color: #ffffff;
  }

  .stack-detail {
    font-family: var(--mono);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Studio Showcase */
  .studio-type-showcase {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 6px 0;
  }

  .type-wordmark {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 0.95;
    color: var(--ink);
  }

  .type-metrics {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: right;
  }

  .metric-line {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--ink-muted);
  }

  .metric-line b {
    color: var(--ink);
    font-weight: 600;
  }

  /* GTM Velocity */
  .gtm-velocity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .velocity-pill {
    display: flex;
