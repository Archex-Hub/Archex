---
// Practices.astro — The Three Core Practices of Archex: Craft, Studio, GTM
---

<section class="section-wrapper practices-section" id="practices" aria-labelledby="practices-title">
  <div class="shell">
    <!-- Section Introduction Header -->
    <div class="section-header">
      <div class="header-left">
        <span class="tech-tag tech-tag--signal">Three Practices</span>
        <h2 id="practices-title" class="section-heading">
          Our practices.
        </h2>
      </div>
      <p class="editorial-note section-quote">
        “Three complementary disciplines. Engaging independently or together.”
      </p>
    </div>

    <!-- The 3 Practice Cards Grid -->
    <div class="practices-grid">
      <!-- ===================================================================
           CARD 1: ARCHEX CRAFT
           =================================================================== -->
      <article class="practice-card practice-card--craft" aria-labelledby="craft-title">
        <div class="card-inner">
          <div class="card-header">
            <span class="card-index">01 / ENGINEERING & TECHNOLOGY</span>
          </div>

          <div class="card-body">
            <h3 id="craft-title" class="card-title">
              Craft<span class="card-period">.</span>
            </h3>
            <p class="card-description">
              Thoughtful software engineering and digital product development, from early ideas to reliable digital systems.
            </p>

            <div class="card-capabilities">
              <span class="capabilities-title">Core capabilities</span>
              <ul class="capabilities-list">
                <li>Software engineering</li>
                <li>Web applications</li>
                <li>Digital products</li>
                <li>AI integration</li>
                <li>Systems and modernization</li>
              </ul>
            </div>
          </div>

          <div class="card-footer">
            <a
              href="https://craft.archexweb.in/"
              class="btn-base btn-primary card-cta card-cta--craft"
              title="Explore Archex Craft — Digital Products & Engineering"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Explore Craft</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <span class="card-url-hint">craft.archexweb.in</span>
          </div>

          <!-- Architectural Graphic: Modular Engineering -->
          <div class="card-graphic" aria-hidden="true">
            <svg class="practice-svg" viewBox="0 0 320 120" fill="none">
              <rect x="10" y="10" width="300" height="100" rx="3" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3" />
              <rect x="25" y="25" width="70" height="70" rx="2" fill="#ffffff" stroke="var(--craft-accent)" stroke-width="1.5" />
              <text x="35" y="44" font-family="var(--mono)" font-size="8" fill="var(--craft-accent)" letter-spacing="1">SYSTEM</text>
              <line x1="35" y1="54" x2="85" y2="54" stroke="var(--line-soft)" stroke-width="1" />
              <rect x="35" y="62" width="50" height="14" rx="1" fill="var(--paper-soft)" />

              <path d="M 95 60 L 145 60" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
              <polygon points="143,57 149,60 143,63" fill="var(--line-strong)" />

              <rect x="150" y="32" width="75" height="56" rx="2" fill="#ffffff" stroke="var(--ink)" stroke-width="1.5" />
              <text x="160" y="50" font-family="var(--mono)" font-size="8" fill="var(--ink)" letter-spacing="1">RUNTIME</text>
              <rect x="160" y="60" width="45" height="12" rx="1" fill="var(--signal-tint)" />

              <line x1="225" y1="60" x2="255" y2="60" stroke="var(--line-strong)" stroke-width="1.5" />
              <polygon points="253,57 259,60 253,63" fill="var(--line-strong)" />

              <circle cx="280" cy="60" r="16" fill="var(--paper-soft)" stroke="var(--craft-accent)" stroke-width="1.5" />
              <circle cx="280" cy="60" r="5" fill="var(--craft-accent)" />
            </svg>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           CARD 2: ARCHEX STUDIO
           =================================================================== -->
      <article class="practice-card practice-card--studio" aria-labelledby="studio-title">
        <div class="card-inner">
          <div class="card-header">
            <span class="card-index">02 / BRAND & EXPERIENCE</span>
          </div>

          <div class="card-body">
            <h3 id="studio-title" class="card-title">
              Studio<span class="card-period">.</span>
            </h3>
            <p class="card-description">
              Brand identity, creative direction and digital experiences built around clarity, meaning and thoughtful design.
            </p>

            <div class="card-capabilities">
              <span class="capabilities-title">Core capabilities</span>
              <ul class="capabilities-list">
                <li>Brand strategy</li>
                <li>Visual identity</li>
                <li>Creative direction</li>
                <li>UI/UX design</li>
                <li>Digital experiences</li>
              </ul>
            </div>
          </div>

          <div class="card-footer">
            <a
              href="https://studio.archexweb.in/"
              class="btn-base btn-secondary card-cta card-cta--studio"
              title="Explore Archex Studio — Brand & Digital Experience"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Explore Studio</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <span class="card-url-hint">studio.archexweb.in</span>
          </div>

          <!-- Architectural Graphic: Geometric Identity & Typographic Form -->
          <div class="card-graphic" aria-hidden="true">
            <svg class="practice-svg" viewBox="0 0 320 120" fill="none">
              <rect x="10" y="10" width="300" height="100" rx="3" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3" />
              
              <circle cx="90" cy="60" r="36" stroke="var(--line)" stroke-width="1" />
              <circle cx="90" cy="60" r="22" stroke="var(--line-soft)" stroke-width="1" />
              <line x1="90" y1="20" x2="90" y2="100" stroke="var(--line-soft)" stroke-width="0.75" />
              <line x1="50" y1="60" x2="130" y2="60" stroke="var(--line-soft)" stroke-width="0.75" />

              <text x="74" y="69" font-family="var(--serif)" font-size="26" fill="var(--ink)">Ax</text>
              <circle cx="116" cy="66" r="3" fill="var(--signal)" />

              <rect x="180" y="28" width="110" height="64" rx="2" fill="#ffffff" stroke="var(--line-strong)" stroke-width="1" />
              <text x="194" y="48" font-family="var(--mono)" font-size="8" fill="var(--ink-faint)" letter-spacing="1">TYPOGRAPHY</text>
              <text x="194" y="66" font-family="var(--serif)" font-size="14" fill="var(--ink)">Instrument.</text>
              <line x1="194" y1="74" x2="270" y2="74" stroke="var(--signal)" stroke-width="1.5" />
            </svg>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           CARD 3: ARCHEX GTM
           =================================================================== -->
      <article class="practice-card practice-card--gtm" aria-labelledby="gtm-title">
        <div class="card-inner">
          <div class="card-header">
            <span class="card-index">03 / GO-TO-MARKET & GROWTH</span>
          </div>

          <div class="card-body">
            <h3 id="gtm-title" class="card-title">
              GTM<span class="card-period">.</span>
            </h3>
            <p class="card-description">
              Go-to-market strategy and execution to help businesses position, launch and grow their products and services.
            </p>

            <div class="card-capabilities">
              <span class="capabilities-title">Core capabilities</span>
              <ul class="capabilities-list capabilities-list--gtm">
                <li>Market research</li>
                <li>Ideal customer profiling</li>
                <li>Positioning and differentiation</li>
                <li>Pricing and packaging</li>
                <li>Launch strategy</li>
                <li>Customer acquisition</li>
                <li>Growth experiments</li>
                <li>Funnel optimisation</li>
              </ul>
            </div>
          </div>

          <div class="card-footer">
            <a
              href="https://gtm.archexweb.in"
              class="btn-base btn-primary card-cta card-cta--gtm"
              title="Enquire about Archex GTM — Go-to-market Strategy & Execution"
            >
              <span>Explore GTM</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <span class="card-url-hint">Coming Soon!</span>
            <span class="card-url-hint">gtm.archexweb.in</span>
          </div>

          <!-- Architectural Graphic: Growth Funnel & Strategy Matrix -->
          <div class="card-graphic" aria-hidden="true">
            <svg class="practice-svg" viewBox="0 0 320 120" fill="none">
              <rect x="10" y="10" width="300" height="100" rx="3" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3" />
              
              <!-- Market Matrix Coordinates -->
              <line x1="40" y1="90" x2="280" y2="90" stroke="var(--line-strong)" stroke-width="1" />
              <line x1="40" y1="30" x2="40" y2="90" stroke="var(--line-strong)" stroke-width="1" />
              
              <!-- Growth Trajectory Curve -->
              <path d="M 40 85 C 100 80, 160 65, 260 35" stroke="var(--signal)" stroke-width="2" />
              <circle cx="260" cy="35" r="4" fill="var(--signal)" />
              <polygon points="268,32 276,35 268,38" fill="var(--signal)" />

              <!-- Milestones -->
              <circle cx="100" cy="81" r="3" fill="#ffffff" stroke="var(--ink)" stroke-width="1.5" />
              <text x="90" y="102" font-family="var(--mono)" font-size="7" fill="var(--ink-faint)">POSITION</text>

              <circle cx="170" cy="67" r="3" fill="#ffffff" stroke="var(--ink)" stroke-width="1.5" />
              <text x="162" y="102" font-family="var(--mono)" font-size="7" fill="var(--ink-faint)">LAUNCH</text>

              <circle cx="240" cy="42" r="3" fill="#ffffff" stroke="var(--signal)" stroke-width="1.5" />
              <text x="234" y="102" font-family="var(--mono)" font-size="7" fill="var(--signal)">SCALE</text>
            </svg>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .practices-section {
    background-color: var(--paper-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 56px);
    flex-wrap: wrap;
  }

  .section-heading {
    font-family: var(--serif);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 12px;
  }

  .section-quote {
    max-width: 360px;
  }

  /* Grid: 3 Equal Practice Cards */
  .practices-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 32px);
    align-items: stretch;
  }

  .practice-card {
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth), border-color var(--transition-smooth);
  }

  .practice-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(20, 20, 19, 0.06);
    border-color: var(--line-strong);
  }

  .card-inner {
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 24px;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-soft);
  }

  .card-index {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--ink-graphite);
    text-transform: uppercase;
  }

  .card-badge {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 2px;
  }

  .card-badge--craft {
    color: var(--craft-accent);
    background-color: var(--craft-tint);
    border: 1px solid rgba(37, 75, 115, 0.2);
  }

  .card-badge--studio {
    color: var(--signal);
    background-color: var(--signal-tint);
    border: 1px solid rgba(156, 62, 47, 0.2);
  }

  .card-badge--gtm {
    color: var(--ink-graphite);
    background-color: rgba(20, 20, 19, 0.05);
    border: 1px solid var(--line);
  }

  .card-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-family: var(--serif);
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 12px;
    line-height: 1.15;
  }

  .card-period {
    color: var(--signal);
  }

  .card-description {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-graphite);
    margin-bottom: 24px;
  }

  .card-capabilities {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
  }

  .capabilities-title {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: block;
    margin-bottom: 10px;
  }

  .capabilities-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .capabilities-list li {
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--ink-soft);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .capabilities-list li::before {
    content: '—';
    font-family: var(--mono);
    font-size: 11px;
    color: var(--line-strong);
    flex-shrink: 0;
  }

  .capabilities-list--gtm {
    columns: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
  }

  .card-cta {
    padding: 12px 20px;
    font-size: 14.5px;
  }

  .card-url-hint {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .card-graphic {
    width: 100%;
    border: 1px solid var(--line-soft);
    border-radius: 2px;
    background-color: var(--paper-soft);
    overflow: hidden;
  }

  .practice-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 1024px) {
    .practices-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

