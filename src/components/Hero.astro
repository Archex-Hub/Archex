    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gtm-telemetry-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.06em;
  }

  .gtm-signal-indicator {
    color: #38bdf8;
    font-weight: 600;
  }

  .gtm-vector-graph {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 12px;
    border-radius: 6px;
  }

  .vector-step {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vector-step.is-highlight .step-metric {
