---
// Hero.astro — Hero: Three disciplines. One direction.
---

<section class="section-wrapper section-wrapper--hero hero" id="top" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero-content">
      <!-- Ecosystem Status & Positioning Badge -->
      <div class="hero-meta-row">
        <span class="hero-positioning-tag" aria-hidden="true">
          Independent thinking. Purposeful execution.
        </span>
      </div>

      <!-- Main Editorial Headline -->
      <h1 id="hero-title" class="hero-headline">
        Three disciplines.<br />
        <span class="hl-accent">One direction<span class="hl-dot">.</span></span>
      </h1>

      <!-- Supporting Editorial Copy -->
      <p class="hero-description">
        Technology, creative thinking and go-to-market strategy, brought together to move ideas forward.
      </p>

      <!-- Action Button Cluster -->
      <div class="hero-actions">
        <a
          href="#practices"
          class="btn-base btn-primary cta-explore"
          title="Explore our three practices"
        >
          <span>Explore our practices</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>

        <a
          href="https://craft.archexweb.in/contact"
          class="btn-base btn-secondary cta-contact"
          title="Contact Archex"
        >
          <span>Contact Archex</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Restrained 3-Discipline Convergence Graphic -->
      <div class="hero-disciplines-bar" aria-label="Archex three disciplines overview">
        <div class="discipline-pillar">
          <div class="pillar-num">01 / CRAFT</div>
          <div class="pillar-name">Engineering & Technology</div>
          <div class="pillar-desc">Software engineering, digital products & systems</div>
          <a href="https://craft.archexweb.in/" class="pillar-link" target="_blank" rel="noopener noreferrer">
            craft.archexweb.in ↗
          </a>
        </div>

        <div class="pillar-divider" aria-hidden="true"></div>

        <div class="discipline-pillar">
          <div class="pillar-num">02 / STUDIO</div>
          <div class="pillar-name">Design & Experience</div>
          <div class="pillar-desc">Brand strategy, visual identity & UI/UX</div>
          <a href="https://studio.archexweb.in/" class="pillar-link" target="_blank" rel="noopener noreferrer">
            studio.archexweb.in ↗
          </a>
        </div>

        <div class="pillar-divider" aria-hidden="true"></div>

        <div class="discipline-pillar">
          <div class="pillar-num">03 / GTM</div>
          <div class="pillar-name">Market & Growth</div>
          <div class="pillar-desc">Positioning, launch planning & growth execution</div>
          <a href="https://gtm.archexweb.in/" class="pillar-link" target="_blank" rel="noopener noreferrer">
            gtm.archexweb.in ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line-soft);
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(24px, 3.5vw, 36px);
    flex-wrap: wrap;
  }

  .hero-positioning-tag {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(14px, 1.2vw, 16px);
    color: var(--ink-graphite);
  }

  .hero-content {
    max-width: 1040px;
  }

  .hero-headline {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(42px, 6.5vw, 88px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }

  .hl-accent {
    color: var(--ink);
    position: relative;
  }

  .hl-dot {
    color: var(--signal);
  }

  .hero-description {
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.5;
    color: var(--ink-graphite);
    max-width: 780px;
    margin-bottom: clamp(32px, 4.5vw, 48px);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: clamp(44px, 6vw, 68px);
  }

  .cta-explore {
    padding: 15px 28px;
    font-size: 16px;
  }

  .cta-contact {
    padding: 15px 26px;
    font-size: 16px;
  }

  /* Disciplines preview bar */
  .hero-disciplines-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: clamp(16px, 2.5vw, 32px);
    align-items: stretch;
    background-color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(20px, 3vw, 32px);
  }

  .discipline-pillar {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pillar-num {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
    font-weight: 600;
  }

  .pillar-name {
    font-family: var(--sans);
    font-size: clamp(16px, 1.4vw, 18px);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .pillar-desc {
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--ink-graphite);
    line-height: 1.45;
    margin-bottom: 8px;
  }

  .pillar-link {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    transition: color var(--transition-fast);
  }

  .pillar-link:hover {
    color: var(--signal);
  }

  .pillar-divider {
    width: 1px;
    background-color: var(--line);
  }

  @media (max-width: 860px) {
    .hero-disciplines-bar {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .pillar-divider {
      width: 100%;
      height: 1px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-base {
      width: 100%;
    }
  }
</style>
