    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 4px 0;
  }

  .specimen-headline {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 0.95;
    color: var(--ink);
  }

  .specimen-curve svg {
    width: 120px;
    height: 45px;
  }

  /* GTM Specimen */
