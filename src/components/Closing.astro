---
// Closing.astro — Graceful closing message and direct destination paths
---

<section class="section-wrapper closing-section" id="closing" aria-labelledby="closing-title">
  <div class="shell">
    <div class="closing-card">
      <div class="closing-meta">
        <span class="tech-tag">Next Step</span>
        <span class="closing-microcopy">“Continue where the work lives.”</span>
      </div>

      <h2 id="closing-title" class="closing-headline">
        Find the direction that fits<span class="closing-dot">.</span>
      </h2>

      <p class="closing-subhead">
        Explore the work that belongs to you.
      </p>

      <div class="closing-actions">
        <a
          href="https://craft.archexweb.in/"
          class="btn-base btn-primary closing-btn closing-btn--craft"
          title="Explore Archex Craft — Digital Products & Engineering"
        >
          <span>Explore Craft</span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>

        <a
          href="https://studio.archexweb.in/"
          class="btn-base btn-secondary closing-btn closing-btn--studio"
          title="Visit Archex Studio — Brand & Digital Experience"
        >
          <span>Visit Studio</span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-section {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(60px, 8vw, 100px);
    border-bottom: 1px solid var(--line-soft);
  }

  .closing-card {
    background-color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(36px, 6vw, 72px) clamp(24px, 5vw, 64px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .closing-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 25%;
    right: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--signal), transparent);
  }

  .closing-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .closing-microcopy {
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-graphite);
  }

  .closing-headline {
    font-family: var(--serif);
    font-size: clamp(34px, 4.5vw, 62px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 16px;
    max-width: 720px;
  }

  .closing-dot {
    color: var(--signal);
  }

  .closing-subhead {
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--ink-graphite);
    margin-bottom: clamp(32px, 4.5vw, 44px);
    max-width: 540px;
    line-height: 1.45;
  }

  .closing-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    width: 100%;
  }

  .closing-btn {
    padding: 15px 30px;
    font-size: 16px;
  }

  .closing-btn--craft {
    background-color: var(--ink);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(20, 20, 19, 0.12);
  }

  @media (max-width: 540px) {
    .closing-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .closing-btn {
      width: 100%;
    }
  }
</style>

