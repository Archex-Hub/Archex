---
// Footer.astro — Footer: Identity, Ecosystem Destinations, Legal & Dynamic Copyright
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="shell">
    <div class="footer-main">
      <!-- Left Column: Wordmark & Description -->
      <div class="footer-brand-col">
        <a href="/" class="footer-wordmark" aria-label="Archex — Home">
          archex<span class="wordmark-dot">.</span>
        </a>
        <p class="footer-desc">
          Archex brings together technology, creative thinking and go-to-market expertise to help ideas become meaningful products, experiences and businesses.
        </p>
        <span class="footer-positioning">Independent thinking. Purposeful execution.</span>
      </div>

      <!-- Navigation Columns -->
      <nav class="footer-nav" aria-label="Footer navigation">
        <!-- Practices Column -->
        <div class="footer-col">
          <span class="footer-col-label">Practices</span>
          <ul class="footer-link-list">
            <li>
              <a
                href="https://craft.archexweb.in/"
                class="footer-link"
                title="Archex Craft — Digital Products & Engineering"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Archex Craft</span>
                <span class="footer-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://studio.archexweb.in/"
                class="footer-link"
                title="Archex Studio — Brand & Digital Experience"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Archex Studio</span>
                <span class="footer-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://gtm.archexweb.in"
                class="footer-link"
                title="Archex GTM — Go-to-Market Strategy & Execution"
              >
                <span>Archex GTM</span>
                <span class="footer-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Ecosystem Column -->
        <div class="footer-col">
          <span class="footer-col-label">Ecosystem</span>
          <ul class="footer-link-list">
            <li>
              <a href="/about" class="footer-link">
                <span>About Archex</span>
              </a>
            </li>
            <li>
              <a href="/contact" class="footer-link">
                <span>Contact Us</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Legal Column -->
        <div class="footer-col">
          <span class="footer-col-label">Legal</span>
          <ul class="footer-link-list">
            <li>
              <a href="/privacy" class="footer-link">
                <span>Privacy Policy</span>
              </a>
            </li>
            <li>
              <a href="/terms" class="footer-link">
                <span>Terms of Service</span>
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <!-- Bottom Line with Dynamic Year & Verified Operator Reference -->
    <div class="footer-bottom">
      <p class="copyright-line">
        © <span id="copyright-year">{currentYear}</span> Archex. All rights reserved.
      </p>
      <div class="footer-bottom-meta">
        <span class="footer-operator-note">archexweb.in</span>
        <span class="footer-separator" aria-hidden="true">•</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Ensure the copyright year is always strictly up-to-date client-side as well
  const yearEl = document.getElementById('copyright-year');
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>

<style>
  .site-footer {
    padding-top: clamp(48px, 7vw, 80px);
    padding-bottom: clamp(32px, 5vw, 48px);
    background-color: var(--paper);
    border-top: 1px solid var(--line);
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    margin-bottom: clamp(40px, 6vw, 64px);
    flex-wrap: wrap;
  }

  .footer-brand-col {
    max-width: 400px;
  }

  .footer-wordmark {
    font-family: var(--serif);
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    display: inline-block;
    margin-bottom: 12px;
  }

  .wordmark-dot {
    color: var(--signal);
  }

  .footer-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-graphite);
    margin-bottom: 14px;
  }

  .footer-positioning {
    font-family: var(--serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--ink-muted);
    display: block;
  }

  .footer-nav {
    display: flex;
    gap: clamp(32px, 5vw, 64px);
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 120px;
  }

  .footer-col-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-family: var(--sans);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--signal);
  }

  .footer-arrow {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .footer-link:hover .footer-arrow {
    transform: translate(2px, -2px);
    color: var(--signal);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--line-soft);
    gap: 16px;
    flex-wrap: wrap;
  }

  .copyright-line {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .footer-bottom-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-operator-note {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }

  .footer-separator {
    color: var(--line);
    font-size: 11px;
  }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      gap: 36px;
    }
    .footer-nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
