---
// CollaborationFramework.astro — How the practices work together
// Interactive Narrative Journey: From Strategy to Experience to Engineering to Market
---

<section class="section-wrapper framework-section" id="framework" aria-labelledby="framework-title">
  <div class="shell">
    <div class="framework-header">
      <div class="header-badge-row">
        <span class="tech-tag tech-tag--signal">The Narrative of Realization</span>
        <span class="framework-mode-pill">Collaborative or Independent</span>
      </div>
      <h2 id="framework-title" class="framework-heading">
        How the practices work together<span class="hl-dot">.</span>
      </h2>
      <p class="framework-lead">
        An idea may need a clear identity, a working product and a route to market. Archex brings those disciplines together when a project calls for them.
      </p>
    </div>

    <!-- Visual Interactive Flow Canvas -->
    <div class="flow-canvas" aria-label="Visual collaboration flow of Archex practices">
      <!-- Top Stage Scrubber / Flow Cards Grid -->
      <div class="flow-steps-grid" role="tablist" aria-label="Stages of realization">
        <!-- Step 1: Strategy & Direction -->
        <div
          class="flow-step is-active"
          id="stage-card-1"
          role="tab"
          aria-selected="true"
          aria-controls="stage-detail-1"
          tabindex="0"
          data-stage="1"
        >
          <div class="step-header">
            <span class="step-num">STAGE 01</span>
            <span class="step-status-dot" aria-hidden="true"></span>
          </div>
          <h3 class="step-title">Strategy and direction</h3>
          <p class="step-desc">
            Framing the problem, clarifying the opportunity, and defining strategic orientation.
          </p>
          <div class="step-tag">FOUNDATION</div>
        </div>

        <div class="flow-connector" aria-hidden="true">
          <svg class="connector-arrow" viewBox="0 0 40 24" fill="none">
            <line x1="0" y1="12" x2="32" y2="12" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
            <polygon points="30,8 38,12 30,16" fill="var(--signal)" />
          </svg>
        </div>

        <!-- Step 2: Studio -->
        <div
          class="flow-step flow-step--studio"
          id="stage-card-2"
          role="tab"
          aria-selected="false"
          aria-controls="stage-detail-2"
          tabindex="0"
          data-stage="2"
        >
          <div class="step-header">
            <span class="step-num">STAGE 02 // STUDIO</span>
            <span class="step-status-dot step-status-dot--studio" aria-hidden="true"></span>
          </div>
          <h3 class="step-title">Design and experience</h3>
          <p class="step-desc">
            Shaping distinctive visual identities, design systems, and thoughtful user experiences.
          </p>
          <div class="step-tag step-tag--studio">ARCHEX STUDIO</div>
        </div>

        <div class="flow-connector" aria-hidden="true">
          <svg class="connector-arrow" viewBox="0 0 40 24" fill="none">
            <line x1="0" y1="12" x2="32" y2="12" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
            <polygon points="30,8 38,12 30,16" fill="var(--signal)" />
          </svg>
        </div>

        <!-- Step 3: Craft -->
        <div
          class="flow-step flow-step--craft"
          id="stage-card-3"
          role="tab"
          aria-selected="false"
          aria-controls="stage-detail-3"
          tabindex="0"
          data-stage="3"
        >
          <div class="step-header">
            <span class="step-num">STAGE 03 // CRAFT</span>
            <span class="step-status-dot step-status-dot--craft" aria-hidden="true"></span>
          </div>
          <h3 class="step-title">Engineering and execution</h3>
          <p class="step-desc">
            Developing robust web applications, resilient software architectures, and digital systems.
          </p>
          <div class="step-tag step-tag--craft">ARCHEX CRAFT</div>
        </div>

        <div class="flow-connector" aria-hidden="true">
          <svg class="connector-arrow" viewBox="0 0 40 24" fill="none">
            <line x1="0" y1="12" x2="32" y2="12" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
            <polygon points="30,8 38,12 30,16" fill="var(--signal)" />
          </svg>
        </div>

        <!-- Step 4: GTM -->
        <div
          class="flow-step flow-step--gtm"
          id="stage-card-4"
          role="tab"
          aria-selected="false"
          aria-controls="stage-detail-4"
          tabindex="0"
          data-stage="4"
        >
          <div class="step-header">
            <span class="step-num">STAGE 04 // GTM</span>
            <span class="step-status-dot step-status-dot--gtm" aria-hidden="true"></span>
          </div>
          <h3 class="step-title">Market introduction</h3>
          <p class="step-desc">
            Positioning the offering, launch execution, customer acquisition, and growth experiments.
          </p>
          <div class="step-tag step-tag--gtm">ARCHEX GTM</div>
        </div>
      </div>

      <!-- Interactive Narrative Insight Tray -->
      <div class="narrative-insight-tray" id="narrative-insight-tray">
        <div class="tray-inner">
          <div class="tray-stage-badge">
            <span class="tray-index" id="tray-index">NARRATIVE INSIGHT // STAGE 01</span>
            <span class="tray-indicator" id="tray-indicator">FOUNDATION</span>
          </div>

          <div class="tray-content">
            <h4 class="tray-headline" id="tray-headline">
              Why clear planning saves you time and money.
            </h4>
            <p class="tray-description" id="tray-description">
              Before spending lakhs on design or coding, we make sure the idea solves a real customer problem that people will happily pay for.
            </p>
          </div>

          <div class="tray-action" id="tray-action">
            <span class="tray-hint">Explore our three dedicated practices:</span>
            <a href="#practices" class="tray-link" id="tray-link">
              <span>View our three practices</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Essential Independence Callout Notice -->
      <div class="framework-notice">
        <div class="notice-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div class="notice-body">
          <span class="notice-title">Collaborative framework, independent engagement</span>
          <p class="notice-text">
            This is a collaborative framework, not a mandatory linear process. Clients engage with individual practices independently, or bring them together whenever a project demands multidisciplinary execution.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive stage insight data (Clear, relatable, value-driven copy)
  const STAGE_INSIGHTS = {
    1: {
      index: "HOW WE WORK // STAGE 01",
      badge: "FOUNDATION & STRATEGY",
      headline: "Why clear planning saves you time and money.",
      description: "Before spending lakhs on design or coding, we make sure the idea solves a real customer problem that people will happily pay for.",
      linkText: "View our three practices",
      linkUrl: "#practices"
    },
    2: {
      index: "HOW WE WORK // STAGE 02",
      badge: "ARCHEX STUDIO",
      headline: "Design that makes people trust your brand instantly.",
      description: "Customers decide whether they trust your business in seconds. Archex Studio creates modern logos, clean screens, and simple UI so your product looks credible and premium.",
      linkText: "Explore Archex Studio (studio.archexweb.in)",
      linkUrl: "https://studio.archexweb.in/"
    },
    3: {
      index: "HOW WE WORK // STAGE 03",
      badge: "ARCHEX CRAFT",
      headline: "Fast, reliable code that never lets your business down.",
      description: "Archex Craft builds websites, apps, and software platforms that load instantly, stay secure, and work smoothly without breaking or crashing.",
      linkText: "Explore Archex Craft (craft.archexweb.in)",
      linkUrl: "https://craft.archexweb.in/"
    },
    4: {
      index: "HOW WE WORK // STAGE 04",
      badge: "ARCHEX GTM",
      headline: "Getting your product in front of real, paying buyers.",
      description: "Even great products fail if nobody knows about them. Archex GTM helps you plan your launch, craft clear sales messaging, and bring in steady customers.",
      linkText: "Explore Archex GTM (gtm.archexweb.in)",
      linkUrl: "https://gtm.archexweb.in"
    }
  };

  function initFrameworkScrubber() {
    const cards = document.querySelectorAll<HTMLElement>('.flow-step');
    const trayIndex = document.getElementById('tray-index');
    const trayIndicator = document.getElementById('tray-indicator');
    const trayHeadline = document.getElementById('tray-headline');
    const trayDesc = document.getElementById('tray-description');
    const trayLink = document.getElementById('tray-link');

    if (!cards.length || !trayIndex || !trayHeadline || !trayDesc || !trayLink) return;

    cards.forEach((card) => {
      const stageId = card.getAttribute('data-stage') || "1";

      const selectStage = () => {
        cards.forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-selected', 'false');
        });
        card.classList.add('is-active');
        card.setAttribute('aria-selected', 'true');

        const insight = STAGE_INSIGHTS[stageId as unknown as keyof typeof STAGE_INSIGHTS];
        if (insight) {
          trayIndex.textContent = insight.index;
          if (trayIndicator) trayIndicator.textContent = insight.badge;
          trayHeadline.textContent = insight.headline;
          trayDesc.textContent = insight.description;
          
          const linkSpan = trayLink.querySelector('span');
          if (linkSpan) linkSpan.textContent = insight.linkText;
          trayLink.setAttribute('href', insight.linkUrl);
          if (insight.linkUrl.startsWith('http')) {
            trayLink.setAttribute('target', '_blank');
            trayLink.setAttribute('rel', 'noopener noreferrer');
          } else {
            trayLink.removeAttribute('target');
            trayLink.removeAttribute('rel');
          }
        }
      };

      card.addEventListener('click', selectStage);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectStage();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFrameworkScrubber);
  } else {
    initFrameworkScrubber();
  }
</script>

<style>
  .framework-section {
    background-color: var(--paper);
    border-bottom: 1px solid var(--line-soft);
    padding-top: clamp(48px, 6vw, 84px);
    padding-bottom: clamp(60px, 8vw, 100px);
  }

  .framework-header {
    max-width: 820px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .framework-mode-pill {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--ink-graphite);
    background: var(--paper-surface);
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--line);
  }

  .framework-heading {
    font-family: var(--serif);
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 18px;
  }

  .framework-lead {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.55;
    color: var(--ink-graphite);
  }

  /* ── Flow Steps Grid ──────────────────────────────────────────────── */
  .flow-steps-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: clamp(10px, 1.5vw, 20px);
    align-items: stretch;
    margin-bottom: 24px;
  }

  .flow-step {
    background-color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(18px, 2.5vw, 26px);
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .flow-step:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.08);
  }

  .flow-step.is-active {
    border-color: var(--signal);
    background: #ffffff;
    box-shadow: 0 10px 24px -8px rgba(156, 62, 47, 0.15);
  }

  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .step-num {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .flow-step.is-active .step-num {
    color: var(--signal);
  }

  .step-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line);
    transition: all 0.2s ease;
  }

  .flow-step.is-active .step-status-dot {
    background: var(--signal);
    box-shadow: 0 0 6px var(--signal);
  }

  .step-title {
    font-family: var(--serif);
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .step-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-graphite);
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .step-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--paper-surface);
    color: var(--ink-graphite);
    width: fit-content;
    border: 1px solid var(--line);
  }

  .step-tag--studio {
    color: var(--signal);
    background: var(--signal-tint);
    border-color: rgba(156, 62, 47, 0.25);
  }

  .step-tag--craft {
    color: #254b73;
    background: rgba(37, 75, 115, 0.08);
    border-color: rgba(37, 75, 115, 0.25);
  }

  .step-tag--gtm {
    color: #0369a1;
    background: rgba(3, 105, 161, 0.08);
    border-color: rgba(3, 105, 161, 0.25);
  }

  .flow-connector {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .connector-arrow {
    width: 28px;
    height: 18px;
  }

  /* ── Interactive Insight Tray ─────────────────────────────────────── */
  .narrative-insight-tray {
    background: #ffffff;
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    border-radius: 8px;
    padding: clamp(20px, 3vw, 28px);
    margin-bottom: 32px;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.05);
  }

  .tray-inner {
    display: grid;
    grid-template-columns: 240px 1fr auto;
    gap: 28px;
    align-items: center;
  }

  .tray-stage-badge {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tray-index {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--signal);
  }

  .tray-indicator {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 400;
    color: var(--ink);
  }

  .tray-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tray-headline {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.3;
    margin: 0;
  }

  .tray-description {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-graphite);
    margin: 0;
  }

  .tray-action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    white-space: nowrap;
  }

  .tray-hint {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-faint);
  }

  .tray-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    background: var(--paper-surface);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .tray-link:hover {
    background: var(--ink);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* ── Independence Notice Callout ──────────────────────────────────── */
  .framework-notice {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(16px, 2.5vw, 22px);
  }

  .notice-icon {
    color: var(--signal);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .notice-title {
    display: block;
    font-family: var(--serif);
    font-size: 16px;
    color: var(--ink);
    margin-bottom: 4px;
    font-weight: 400;
  }

  .notice-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-graphite);
    margin: 0;
  }

  /* Responsive Rules */
  @media (max-width: 980px) {
    .flow-steps-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .flow-connector {
      transform: rotate(90deg);
      padding: 4px 0;
    }

    .tray-inner {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .tray-action {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-step, .tray-link {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
