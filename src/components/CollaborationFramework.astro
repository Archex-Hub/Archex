---
// CollaborationFramework.astro — How the practices work together
---

<section class="section-wrapper framework-section" id="framework" aria-labelledby="framework-title">
  <div class="shell">
    <div class="framework-header">
      <span class="tech-tag tech-tag--signal">Collaboration Framework</span>
      <h2 id="framework-title" class="framework-heading">
        How the practices work together<span class="hl-dot">.</span>
      </h2>
      <p class="framework-lead">
        An idea may need a clear identity, a working product and a route to market. Archex brings those disciplines together when a project calls for them.
      </p>
    </div>

    <!-- Visual Flow Diagram -->
    <div class="flow-canvas" aria-label="Visual collaboration flow of Archex practices">
      <div class="flow-steps-grid">
        <!-- Step 1 -->
        <div class="flow-step">
          <div class="step-num">STAGE 01</div>
          <h3 class="step-title">Strategy and direction</h3>
          <p class="step-desc">
            Framing the problem, clarifying the opportunity, and defining strategic orientation.
          </p>
          <div class="step-tag">FOUNDATION</div>
        </div>

        <div class="flow-connector" aria-hidden="true">
          <svg class="connector-arrow" viewBox="0 0 40 24" fill="none">
            <line x1="0" y1="12" x2="32" y2="12" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
            <polygon points="30,8 38,12 30,16" fill="var(--signal)" />
          </svg>
        </div>

        <!-- Step 2 -->
        <div class="flow-step flow-step--studio">
          <div class="step-num">STAGE 02 // STUDIO</div>
          <h3 class="step-title">Design and experience</h3>
          <p class="step-desc">
            Shaping distinctive visual identities, design systems, and thoughtful user experiences.
          </p>
          <div class="step-tag step-tag--studio">ARCHEX STUDIO</div>
        </div>

        <div class="flow-connector" aria-hidden="true">
          <svg class="connector-arrow" viewBox="0 0 40 24" fill="none">
            <line x1="0" y1="12" x2="32" y2="12" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
            <polygon points="30,8 38,12 30,16" fill="var(--signal)" />
          </svg>
        </div>

        <!-- Step 3 -->
        <div class="flow-step flow-step--craft">
          <div class="step-num">STAGE 03 // CRAFT</div>
          <h3 class="step-title">Engineering and execution</h3>
          <p class="step-desc">
            Developing robust web applications, resilient software architectures, and digital systems.
          </p>
          <div class="step-tag step-tag--craft">ARCHEX CRAFT</div>
        </div>

        <div class="flow-connector" aria-hidden="true">
          <svg class="connector-arrow" viewBox="0 0 40 24" fill="none">
            <line x1="0" y1="12" x2="32" y2="12" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" />
            <polygon points="30,8 38,12 30,16" fill="var(--signal)" />
          </svg>
        </div>

        <!-- Step 4 -->
        <div class="flow-step flow-step--gtm">
          <div class="step-num">STAGE 04 // GTM</div>
          <h3 class="step-title">Market introduction</h3>
          <p class="step-desc">
            Positioning the offering, launch execution, customer acquisition, and growth experiments.
          </p>
          <div class="step-tag step-tag--gtm">ARCHEX GTM</div>
        </div>
      </div>

      <!-- Essential Independence Callout Notice -->
      <div class="framework-notice">
        <div class="notice-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div class="notice-body">
          <span class="notice-title">Collaborative framework, independent engagement</span>
          <p class="notice-text">
            This is a collaborative framework, not a mandatory linear process. Clients engage with individual practices independently, or bring them together whenever a project demands multidisciplinary execution.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .framework-section {
    border-bottom: 1px solid var(--line-soft);
  }

  .framework-header {
    max-width: 820px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .framework-heading {
    font-family: var(--serif);
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 14px;
    margin-bottom: 16px;
  }

  .hl-dot {
    color: var(--signal);
  }

  .framework-lead {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink-graphite);
  }

  /* Flow Canvas */
  .flow-canvas {
    background-color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 3.5vw, 44px);
  }

  .flow-steps-grid {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .flow-step {
    flex: 1 1 0;
    background-color: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(18px, 2.2vw, 26px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .flow-step:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .flow-step--craft {
    border-top: 3px solid var(--craft-accent);
  }

  .flow-step--studio {
    border-top: 3px solid var(--signal);
  }

  .flow-step--gtm {
    border-top: 3px solid var(--ink);
  }

  .step-num {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .step-title {
    font-family: var(--sans);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.3;
  }

  .step-desc {
    font-size: 13.5px;
    color: var(--ink-graphite);
    line-height: 1.5;
    margin-bottom: auto;
  }

  .step-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 3px 6px;
    background-color: rgba(20, 20, 19, 0.03);
    border-radius: 2px;
    align-self: flex-start;
  }

  .step-tag--craft {
    color: var(--craft-accent);
    background-color: var(--craft-tint);
  }

  .step-tag--studio {
    color: var(--signal);
    background-color: var(--signal-tint);
  }

  .step-tag--gtm {
    color: var(--ink);
    background-color: rgba(20, 20, 19, 0.06);
  }

  .flow-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    flex-shrink: 0;
  }

  .connector-arrow {
    width: 32px;
    height: 20px;
  }

  /* Notice Callout */
  .framework-notice {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 22px;
    background-color: #ffffff;
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    border-radius: 3px;
  }

  .notice-icon {
    color: var(--signal);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .notice-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .notice-title {
    font-family: var(--sans);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
  }

  .notice-text {
    font-size: 14px;
    color: var(--ink-graphite);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .flow-steps-grid {
      flex-direction: column;
      gap: 16px;
    }
    .flow-connector {
      width: 100%;
      height: 24px;
      transform: rotate(90deg);
    }
  }
</style>

